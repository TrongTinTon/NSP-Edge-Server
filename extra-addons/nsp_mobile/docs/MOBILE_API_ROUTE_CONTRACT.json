{
  "version": "v1",
  "base_path": "/v1/mobile",
  "identity": {
    "authentication_model": "res.users",
    "business_profile_model": "nsp.user",
    "cardinality": "1:1 for internal Odoo Users",
    "token_subject_model": "res.users"
  },
  "routes": [
    {"method": "POST", "path": "/v1/mobile/auth/login"},
    {"method": "POST", "path": "/v1/mobile/auth/refresh"},
    {"method": "POST", "path": "/v1/mobile/auth/logout"},
    {"method": "PATCH", "path": "/v1/mobile/auth/password"},
    {"method": "GET", "path": "/v1/mobile/profile"},
    {"method": "PATCH", "path": "/v1/mobile/profile"},
    {"method": "GET", "path": "/v1/mobile/device"},
    {"method": "PATCH", "path": "/v1/mobile/device"},
    {"method": "DELETE", "path": "/v1/mobile/device"},
    {"method": "POST", "path": "/v1/mobile/device/heartbeat"},
    {"method": "GET", "path": "/v1/mobile/vehicles"},
    {"method": "GET", "path": "/v1/mobile/vehicles/detail"},
    {"method": "GET", "path": "/v1/mobile/parking/transactions"},
    {"method": "GET", "path": "/v1/mobile/friends/search"},
    {"method": "GET", "path": "/v1/mobile/friends"},
    {"method": "GET", "path": "/v1/mobile/friend-requests"},
    {"method": "POST", "path": "/v1/mobile/friend-requests"},
    {"method": "POST", "path": "/v1/mobile/friend-requests/accept"},
    {"method": "POST", "path": "/v1/mobile/friend-requests/cancel"},
    {"method": "GET", "path": "/v1/mobile/vehicle-borrows"},
    {"method": "POST", "path": "/v1/mobile/vehicle-borrows"},
    {"method": "POST", "path": "/v1/mobile/vehicle-borrows/end"},
    {"method": "POST", "path": "/v1/mobile/vehicle-borrows/cancel"},
    {"method": "GET", "path": "/v1/mobile/notifications"},
    {"method": "GET", "path": "/v1/mobile/notifications/unread-count"},
    {"method": "POST", "path": "/v1/mobile/notifications/read"},
    {"method": "POST", "path": "/v1/mobile/notifications/read-all"},
    {"method": "GET", "path": "/v1/mobile/notifications/events"}
  ]
}
