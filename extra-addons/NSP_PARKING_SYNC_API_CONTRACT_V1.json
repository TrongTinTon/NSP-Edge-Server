{
  "contract": "NSP Parking and Lane Calibration Sync API",
  "version": "1.0",
  "core_api_prefix": "/v1",
  "controller_updated": false,
  "routes": [
    {
      "direction": "edge_to_cloud",
      "method": "POST",
      "route_suffix": "edge/status",
      "versioned_path": "/v1/edge/status",
      "endpoint_code": "nsp_edge_status",
      "purpose": "Edge heartbeat and runtime inventory report"
    },
    {
      "direction": "cloud_to_edge",
      "method": "POST",
      "route_suffix": "edge/parking-runtime/snapshot",
      "versioned_path": "/v1/edge/parking-runtime/snapshot",
      "endpoint_code": "nsp_edge_parking_runtime_snapshot",
      "purpose": "Published Parking Layout runtime full snapshot"
    },
    {
      "direction": "cloud_to_edge",
      "method": "POST",
      "route_suffix": "edge/lane-calibrations/snapshot",
      "versioned_path": "/v1/edge/lane-calibrations/snapshot",
      "endpoint_code": "nsp_edge_lane_calibration_snapshot",
      "purpose": "Released Lane Calibration full snapshot"
    },
    {
      "direction": "edge_to_cloud",
      "method": "POST",
      "route_suffix": "edge/lane-calibrations/events",
      "versioned_path": "/v1/edge/lane-calibrations/events",
      "endpoint_code": "nsp_edge_lane_calibration_events",
      "purpose": "Lane Calibration observation batch"
    },
    {
      "direction": "edge_to_cloud",
      "method": "POST",
      "route_suffix": "edge/lane-calibrations/status",
      "versioned_path": "/v1/edge/lane-calibrations/status",
      "endpoint_code": "nsp_edge_lane_calibration_status",
      "purpose": "Lane Calibration lifecycle status"
    },
    {
      "direction": "edge_to_cloud",
      "method": "POST",
      "route_suffix": "edge/parking-transactions",
      "versioned_path": "/v1/edge/parking-transactions",
      "endpoint_code": "nsp_edge_parking_transactions",
      "purpose": "Final idempotent Parking Transaction batch"
    }
  ],
  "parking_lane_payload": {
    "required": [
      "lane_code",
      "lane_name",
      "server_code",
      "controller_code",
      "antenna_timeline",
      "event_sequences",
      "timing_tolerance"
    ],
    "removed": [
      "direction",
      "antenna_transitions",
      "check_in_sequence",
      "check_out_sequence"
    ],
    "device_projection": "controllers[].devices",
    "invariants": [
      "Timeline order is contiguous from 1",
      "Every configured Event Sequence contains at least two adjacent Timeline antennas",
      "Check-in and Check-out use opposite Timeline orientations when both are configured",
      "One antenna belongs to only one operational lane"
    ]
  },
  "idempotency": {
    "detection": "event_uid",
    "parking_transaction": "transaction_uid"
  }
}
