<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Use the NSP Gatekeeper app icon in the Odoo app switcher. -->
    <record id="nsp_core.menu_nsp_root" model="ir.ui.menu">
        <field name="web_icon">nsp_gatekeeper,static/description/icon.png</field>
    </record>

    <!-- Configuration / Gatekeeper -->
    <menuitem id="nsp_device_root"
              name="Gatekeeper"
              parent="nsp_core.menu_nsp_configuration"
              sequence="10"
              groups="nsp_core.group_nsp_it_parking"/>

    <!-- Branch master belongs directly under Gatekeeper. -->
    <menuitem id="menu_nsp_branch"
              name="Branches"
              parent="nsp_device_root"
              action="action_nsp_branch"
              sequence="10"/>

    <!-- Setup -->
    <menuitem id="menu_nsp_setup_root"
              name="Setup"
              parent="nsp_device_root"
              sequence="20"/>

    <menuitem id="menu_nsp_parking_area"
              name="Parking Configuration"
              parent="menu_nsp_setup_root"
              action="action_nsp_parking_area"
              sequence="10"/>

    <menuitem id="menu_nsp_infrastructure_root"
              name="Infrastructure"
              parent="menu_nsp_setup_root"
              sequence="20"/>

    <menuitem id="menu_nsp_edge_servers"
              name="Edge Servers"
              parent="menu_nsp_infrastructure_root"
              action="action_nsp_edge_servers"
              sequence="10"/>

    <menuitem id="nsp_controller_menu"
              name="Controllers"
              parent="menu_nsp_infrastructure_root"
              action="action_nsp_controllers"
              sequence="20"/>

    <menuitem id="nsp_device_menu"
              name="Readers"
              parent="menu_nsp_infrastructure_root"
              action="nsp_device_action"
              sequence="30"/>

    <menuitem id="menu_nsp_device_antenna"
              name="Antennas"
              parent="menu_nsp_infrastructure_root"
              action="action_nsp_device_antenna"
              sequence="40"/>

    <!-- Measurement Sessions is the Measurement entry itself; avoid a redundant submenu. -->
    <menuitem id="menu_nsp_measurement"
              name="Measurement"
              parent="nsp_device_root"
              action="action_nsp_measurement_session"
              sequence="30"/>

    <!-- Runtime/business events -->
    <menuitem id="menu_nsp_events_root"
              name="Events"
              parent="nsp_device_root"
              sequence="40"/>

    <menuitem id="menu_nsp_parking_transaction"
              name="Parking Transactions"
              parent="menu_nsp_events_root"
              action="action_nsp_parking_transaction"
              sequence="10"/>

    <menuitem id="menu_nsp_parking_detection_event"
              name="Detection Events"
              parent="menu_nsp_events_root"
              action="action_nsp_parking_detection_event"
              sequence="20"
              groups="nsp_core.group_nsp_it_parking"/>

    <!-- Device master/reference configuration remains under the global Configuration menu. -->
    <menuitem id="menu_nsp_device_whitelist"
              name="Device Whitelist"
              parent="nsp_core.menu_nsp_master_data"
              action="nsp_device_whitelist_action"
              sequence="40"
              groups="nsp_core.group_nsp_it_parking"/>

    <menuitem id="menu_nsp_device_types"
              name="Device Types"
              parent="nsp_core.menu_nsp_reference_data"
              action="action_nsp_device_type"
              sequence="60"
              groups="nsp_core.group_nsp_it_parking"/>

</odoo>
