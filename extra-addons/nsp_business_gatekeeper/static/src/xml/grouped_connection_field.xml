<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nsp_business_gatekeeper.GroupedConnectionField">
        <span t-if="props.readonly" t-esc="string"/>
        <SelectMenu t-else=""
                    value="value"
                    choices="[]"
                    groups="groupedChoices"
                    onSelect.bind="onChange"
                    required="props.required"
                    searchable="false"
                    placeholder="props.placeholder"/>
    </t>
</templates>
