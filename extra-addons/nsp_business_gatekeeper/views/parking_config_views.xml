<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nsp_parking_area_search" model="ir.ui.view">
        <field name="name">nsp.parking.operation.search</field>
        <field name="model">nsp.parking.area</field>
        <field name="arch" type="xml">
            <search string="Parking Configuration">
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="controller_ids"/>
                <filter string="Operational" name="operational" domain="[('state','=','operational')]"/>
                <filter string="Configuring" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('state','=','maintenance')]"/>
                <filter string="Blocked" name="blocked" domain="[('state','=','blocked')]"/>
                <separator/>
                <group>
                    <filter string="Branch" name="group_branch" context="{'group_by':'branch_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_nsp_parking_area_list" model="ir.ui.view">
        <field name="name">nsp.parking.operation.list</field>
        <field name="model">nsp.parking.area</field>
        <field name="arch" type="xml">
            <list string="Parking Configuration" create="0" edit="0" delete="0">
                <field name="state" widget="badge"
                       decoration-success="state == 'operational'"
                       decoration-warning="state == 'draft' or state == 'maintenance'"
                       decoration-danger="state == 'blocked'"/>
                <field name="name"/>
                <field name="code" string="Technical Code" optional="hide"/>
                <field name="branch_id"/>
                <field name="controller_count" string="Controllers"/>
                <field name="reader_count" string="Readers"/>
                <field name="lane_count" string="Lanes"/>
                <field name="antenna_count" string="Antennas"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_parking_area_form" model="ir.ui.view">
        <field name="name">nsp.parking.operation.form</field>
        <field name="model">nsp.parking.area</field>
        <field name="arch" type="xml">
            <form string="Parking Operation Configuration" create="0" edit="0" delete="0">
                <header>
                    <button name="action_set_operational" type="object" string="Set Operational"
                            class="oe_highlight" invisible="state == 'operational'"/>
                    <button name="action_set_maintenance" type="object" string="Set Maintenance"
                            invisible="state == 'maintenance'"/>
                    <button name="action_set_blocked" type="object" string="Block"
                            invisible="state == 'blocked'"/>
                    <button name="action_reset_to_draft" type="object" string="Back to Configuration"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,operational,maintenance,blocked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_live_monitor" type="object" class="oe_stat_button" icon="fa-desktop"
                                groups="nsp_core.group_nsp_operator,nsp_core.group_nsp_it_parking,base.group_system">
                            <span class="o_stat_text">Live Monitor</span>
                        </button>
                        <button name="action_open_controllers" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="controller_count" widget="statinfo" string="Controllers"/>
                        </button>
                        <button name="action_open_readers" type="object" class="oe_stat_button" icon="fa-rss">
                            <field name="reader_count" widget="statinfo" string="Readers"/>
                        </button>
                        <button name="action_open_antennas" type="object" class="oe_stat_button" icon="fa-signal">
                            <field name="antenna_count" widget="statinfo" string="Antennas"/>
                        </button>
                        <button name="action_open_lanes" type="object" class="oe_stat_button" icon="fa-road">
                            <field name="lane_count" widget="statinfo" string="Lanes"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Parking Area A"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert">
                        Parking topology is synchronized from Cloud and used by the Edge business engine. Each lane selects one Controller and receives directed Antenna Transitions from Cloud. Every transition carries From Antenna, To Antenna, Event Type and Duration; fixed lane timing windows are not used.
                    </div>

                    <group>
                        <group string="Parking Operation">
                            <field name="branch_id" options="{'no_create': False, 'no_open': False}"/>
                            <field name="state" readonly="1"/>
                            <field name="motorbike_capacity" string="Motorbike Capacity"/>
                            <field name="live_monitor_columns" string="Live Monitor Columns"/>
                            <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar" groups="nsp_core.group_nsp_it_parking"/>
                        </group>
                        <group string="Derived Infrastructure">
                            <field name="controller_ids" widget="many2many_tags" readonly="1"/>
                            <field name="reader_ids" widget="many2many_tags" readonly="1"/>
                            <field name="antenna_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="1. Parking Lanes">
                            <div class="alert alert-secondary" role="alert">
                                Assign one Controller to each Lane. Check-in or Check-out is not stored on the Lane; it is defined by each directed Antenna Transition.
                            </div>
                            <field name="lane_ids" context="{'default_parking_area_id': id}">
                                <list editable="bottom" create="0" edit="0" delete="0">
                                    <field name="lane_no" string="Lane No"/>
                                    <field name="name" string="Lane Name"/>
                                    <field name="code" string="Technical Code" optional="hide" readonly="1"/>
                                    <field name="controller_id" options="{'no_create': False, 'no_open': False}"/>
                                    <field name="active" widget="boolean_toggle"/>
                                    <field name="transition_count" string="Transitions" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="2. Antenna Transitions">
                            <div class="alert alert-secondary" role="alert">
                                Define the physical path used to validate a vehicle movement. Example: Antenna 1 → Antenna 2, Check-in, Duration 2 seconds. The Edge uses this configured Duration as the valid movement window.
                            </div>
                            <button name="action_open_antenna_transitions" type="object"
                                    string="Configure Antenna Transitions" class="oe_highlight" icon="fa-exchange"/>
                            <field name="antenna_transition_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="lane_id"/>
                                    <field name="event_type" widget="badge"/>
                                    <field name="from_antenna_id" string="From Antenna"/>
                                    <field name="to_antenna_id" string="To Antenna"/>
                                    <field name="duration_seconds" string="Duration (s)"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_parking_area" model="ir.actions.act_window">
        <field name="name">Parking Configuration</field>
        <field name="res_model">nsp.parking.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_parking_area_search"/>
    </record>

    <record id="view_nsp_parking_lane_list" model="ir.ui.view">
        <field name="name">nsp.parking.lane.list</field>
        <field name="model">nsp.parking.lane</field>
        <field name="arch" type="xml">
            <list string="Parking Lanes" create="0" edit="0" delete="0">
                <field name="parking_area_id"/>
                <field name="lane_no" string="Lane No"/>
                <field name="name" string="Lane Name" decoration-bf="1"/>
                <field name="code" string="Technical Code" optional="hide" readonly="1"/>
                <field name="controller_id"/>
                <field name="transition_count" string="Transitions" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_parking_lane_form" model="ir.ui.view">
        <field name="name">nsp.parking.lane.form</field>
        <field name="model">nsp.parking.lane</field>
        <field name="arch" type="xml">
            <form string="Parking Lane" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Parking Lane 01"/></h1>
                    </div>
                    <group>
                        <group string="Lane Declaration">
                            <field name="parking_area_id" options="{'no_create': False, 'no_open': False}"/>
                            <field name="controller_id" options="{'no_create': False, 'no_open': False}"/>
                            <field name="lane_no" string="Lane No"/>
                            <field name="active"/>
                        </group>
                        <group string="Identity">
                            <field name="transition_count" string="Antenna Transitions" readonly="1"/>
                            <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar" groups="nsp_core.group_nsp_it_parking"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Antenna Transitions">
                            <div class="alert alert-info" role="alert">
                                Configure the ordered antenna path directly. Event Type defines Check-in or Check-out. Duration is the maximum time allowed from the first antenna detection to the next antenna detection for the same Vehicle RFID.
                            </div>
                            <field name="antenna_transition_ids" context="{'default_lane_id': id}">
                                <list editable="bottom" create="0" edit="0" delete="0">
                                    <field name="lane_controller_id" column_invisible="1"/>
                                    <field name="event_type"/>
                                    <field name="from_antenna_id" string="From Antenna" domain="[('device_id.controller_id','=',parent.controller_id)]"/>
                                    <field name="to_antenna_id" string="To Antenna" domain="[('device_id.controller_id','=',parent.controller_id)]"/>
                                    <field name="duration_seconds" string="Duration (s)"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_parking_lane" model="ir.actions.act_window">
        <field name="name">Parking Lanes</field>
        <field name="res_model">nsp.parking.lane</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_nsp_parking_antenna_transition_list" model="ir.ui.view">
        <field name="name">nsp.parking.antenna.transition.list</field>
        <field name="model">nsp.parking.antenna.transition</field>
        <field name="arch" type="xml">
            <list string="Antenna Transitions" editable="bottom" create="0" edit="0" delete="0">
                <field name="lane_controller_id" column_invisible="1"/>
                <field name="parking_area_id" readonly="1"/>
                <field name="lane_id"/>
                <field name="event_type" widget="badge"/>
                <field name="from_antenna_id" string="From Antenna" domain="[('device_id.controller_id','=',lane_controller_id)]"/>
                <field name="to_antenna_id" string="To Antenna" domain="[('device_id.controller_id','=',lane_controller_id)]"/>
                <field name="duration_seconds" string="Duration (s)"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_parking_antenna_transition_form" model="ir.ui.view">
        <field name="name">nsp.parking.antenna.transition.form</field>
        <field name="model">nsp.parking.antenna.transition</field>
        <field name="arch" type="xml">
            <form string="Antenna Transition" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="rule_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Movement">
                            <field name="lane_id"/>
                            <field name="parking_area_id" readonly="1"/>
                            <field name="lane_controller_id" readonly="1"/>
                            <field name="event_type"/>
                            <field name="duration_seconds" string="Duration (Seconds)"/>
                        </group>
                        <group string="Antenna Path">
                            <field name="from_antenna_id" domain="[('device_id.controller_id','=',lane_controller_id)]"/>
                            <field name="to_antenna_id" domain="[('device_id.controller_id','=',lane_controller_id)]"/>
                            <field name="from_serial_number" string="From Reader Serial" readonly="1"/>
                            <field name="to_serial_number" string="To Reader Serial" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_parking_antenna_transition" model="ir.actions.act_window">
        <field name="name">Antenna Transitions</field>
        <field name="res_model">nsp.parking.antenna.transition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
