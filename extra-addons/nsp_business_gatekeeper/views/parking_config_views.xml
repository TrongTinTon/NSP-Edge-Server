<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_nsp_parking_area_search" model="ir.ui.view">
        <field name="name">nsp.parking.operation.search</field>
        <field name="model">nsp.parking.area</field>
        <field name="arch" type="xml">
            <search string="Parking Layout">
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <filter string="Operational" name="operational" domain="[('state','=','operational')]"/>
                <filter string="Configuring" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('state','=','maintenance')]"/>
                <filter string="Blocked" name="blocked" domain="[('state','=','blocked')]"/>
                <separator/>
                <group>
                    <filter string="Branch" name="group_branch" context="{'group_by':'branch_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_nsp_parking_area_list" model="ir.ui.view">
        <field name="name">nsp.parking.operation.list</field>
        <field name="model">nsp.parking.area</field>
        <field name="arch" type="xml">
            <list string="Parking Layout" create="0" edit="0" delete="0">
                <field name="state" widget="badge" decoration-success="state == 'operational'" decoration-warning="state == 'draft' or state == 'maintenance'" decoration-danger="state == 'blocked'"/>
                <field name="name"/>
                <field name="code" string="Technical Code" optional="hide"/>
                <field name="branch_id"/>
                <field name="lane_count" string="Lanes"/>
                </list>
        </field>
    </record>

    <record id="view_nsp_parking_area_form" model="ir.ui.view">
        <field name="name">nsp.parking.operation.form</field>
        <field name="model">nsp.parking.area</field>
        <field name="arch" type="xml">
            <form string="Parking Layout" create="0" edit="0" delete="0">
                <header>
                    <button name="action_set_operational" type="object" string="Set Operational" class="oe_highlight" invisible="state == 'operational'"/>
                    <button name="action_set_maintenance" type="object" string="Set Maintenance" invisible="state == 'maintenance'"/>
                    <button name="action_set_blocked" type="object" string="Block" invisible="state == 'blocked'"/>
                    <button name="action_reset_to_draft" type="object" string="Back to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,operational,maintenance,blocked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_live_monitor" type="object" class="oe_stat_button" icon="fa-desktop" groups="nsp_core.group_nsp_operator,nsp_core.group_nsp_it_parking,base.group_system">
                            <span class="o_stat_text">Live Monitor</span>
                        </button>
                        </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Parking Area A"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert">Parking Lanes and movement rules are synchronized from Cloud. Edge uses them as read-only runtime configuration.</div>

                    <group>
                        <group string="Parking Operation">
                            <field name="branch_id" options="{'no_create': False, 'no_quick_create': False, 'no_create_edit': False, 'no_open': False}" context="{'form_view_ref': 'nsp_business_gatekeeper.view_nsp_branch_form'}"/>
                            <field name="state" readonly="1"/>
                            <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar" groups="nsp_core.group_nsp_it_parking"/>
                        </group>
                        </group>

                    <separator string="Lanes"/><div class="alert alert-info" role="alert">
                Each Lane contains its directed antenna movement rules. The Edge receives this layout from Cloud and does not create infrastructure devices locally.
            </div>
            <field name="lane_ids" readonly="1">
                <list create="0" edit="0" delete="0">
                    <field name="name" string="Lane Name"/>
                    <field name="controller_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="[('active','=',True),('whitelist_id.active','=',True),('whitelist_id.device_type_code','=','CONTROLLER')]"/>
                    <field name="transition_count" string="Movement Rules" readonly="1"/>
                    <field name="active" widget="boolean_toggle" readonly="1"/>
                </list>
            </field>
        </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_parking_area" model="ir.actions.act_window">
        <field name="name">Parking Layout</field>
        <field name="res_model">nsp.parking.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_parking_area_search"/>
    </record>

    <record id="view_nsp_parking_lane_list" model="ir.ui.view">
        <field name="name">nsp.parking.lane.list</field>
        <field name="model">nsp.parking.lane</field>
        <field name="arch" type="xml">
            <list string="Parking Lanes" create="0" edit="0" delete="0">
                <field name="parking_area_id"/>
                <field name="name" string="Lane Name" decoration-bf="1"/>
                <field name="code" string="Technical Code" optional="hide" readonly="1"/>
                <field name="controller_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="[('active','=',True),('whitelist_id.active','=',True),('whitelist_id.device_type_code','=','CONTROLLER')]"/>
                <field name="transition_count" string="Movement Rules" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_parking_lane_form" model="ir.ui.view">
        <field name="name">nsp.parking.lane.form</field>
        <field name="model">nsp.parking.lane</field>
        <field name="arch" type="xml">
            <form string="Parking Lane" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Parking Lane"/></h1>
                    </div>
                    <group>
                        <group string="Lane Declaration">
                            <field name="parking_area_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': False}"/>
                            <field name="controller_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="[('active','=',True),('whitelist_id.active','=',True),('whitelist_id.device_type_code','=','CONTROLLER')]"/>
                                        <field name="active"/>
                        </group>
                        <group string="Identity">
                            <field name="transition_count" string="Movement Rules" readonly="1"/>
                            <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar" groups="nsp_core.group_nsp_it_parking"/>
                        </group>
                    </group>
                    <group string="Movement Rules">
                <div class="alert alert-info" role="alert" colspan="2">
                    Directed rules are synchronized from Cloud. Event Type comes from the physical antenna order; Duration is the maximum allowed time between both detections for the same Vehicle RFID.
                </div>
                <field name="antenna_transition_ids" readonly="1" colspan="2">
                    <list create="0" edit="0" delete="0">
                        <field name="from_antenna_id" string="From Antenna" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="[('device_id.controller_id','=',parent.controller_id),('active','=',True),('whitelist_id.active','=',True),('whitelist_id.device_type_code','=','ANTENNA')]"/>
                        <field name="to_antenna_id" string="To Antenna" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" domain="[('device_id.controller_id','=',parent.controller_id),('active','=',True),('whitelist_id.active','=',True),('whitelist_id.device_type_code','=','ANTENNA')]"/>
                        <field name="event_type" widget="badge" decoration-success="event_type == 'check_in'" decoration-info="event_type == 'check_out'"/>
                        <field name="duration_seconds" string="Duration (s)"/>
                    </list>
                </field>
            </group></sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_parking_lane" model="ir.actions.act_window">
        <field name="name">Parking Lanes</field>
        <field name="res_model">nsp.parking.lane</field>
        <field name="view_mode">list,form</field>
    </record>

    </odoo>
