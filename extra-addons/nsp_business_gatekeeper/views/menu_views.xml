<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Use the NSP Gatekeeper app icon in the Odoo app switcher. -->
    <record id="nsp_core.menu_nsp_root" model="ir.ui.menu">
        <field name="web_icon">nsp_business_gatekeeper,static/description/icon.png</field>
    </record>

    <!-- Keep Configuration focused on the two operational setup workflows. -->
    <menuitem id="menu_nsp_parking_area"
              name="Parking Layout"
              parent="nsp_core.menu_nsp_configuration"
              action="action_nsp_parking_area"
              sequence="10"
              groups="nsp_core.group_nsp_it_parking"/>

    <menuitem id="menu_nsp_measurement"
              name="Lane Calibration"
              parent="nsp_core.menu_nsp_configuration"
              action="action_nsp_measurement_session"
              sequence="20"
              groups="nsp_core.group_nsp_it_parking"/>

    <!-- Parking business history is a first-class operational menu. -->
    <menuitem id="menu_nsp_transactions"
              name="Transactions"
              parent="nsp_core.menu_nsp_root"
              action="action_nsp_parking_transaction"
              sequence="30"
              groups="nsp_core.group_nsp_operator,nsp_core.group_nsp_it_parking"/>
</odoo>
