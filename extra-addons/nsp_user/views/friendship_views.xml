<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nsp_user_friendship_form" model="ir.ui.view">
        <field name="name">nsp.user.friendship.form</field>
        <field name="model">nsp.user.friendship</field>
        <field name="arch" type="xml">
            <form string="Friend">
                <header>
                    <button name="action_accept" type="object" string="Accept" icon="fa-check"
                            help="Accept request" class="btn-primary" invisible="state == 'accepted'"/>
                    <button name="action_cancel" type="object" string="Decline" icon="fa-times"
                            help="Decline request" invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Remove" icon="fa-user-times"
                            help="Remove friend" invisible="state != 'accepted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,accepted" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="requester_id" string="From" readonly="state != 'pending'"/>
                        <field name="addressee_id" string="Friend" readonly="state != 'pending'"/>
                        <field name="accepted_at" string="Since" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
