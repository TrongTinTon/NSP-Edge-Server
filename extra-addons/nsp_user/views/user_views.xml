<odoo>
    <record id="view_nsp_user_search" model="ir.ui.view">
        <field name="name">nsp.user.search</field>
        <field name="model">nsp.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="user_code" string="Technical Code"/>
                <field name="web_user_id" groups="base.group_system"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Web Access" name="web_access" domain="[('web_user_id','!=',False)]" groups="base.group_system"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="view_nsp_user_list" model="ir.ui.view">
        <field name="name">nsp.user.list</field>
        <field name="model">nsp.user</field>
        <field name="arch" type="xml">
            <list string="Users" decoration-muted="not active">
                <field name="image_128" string="Avatar" widget="image" class="o_avatar" optional="show"/>
                <field name="name" decoration-bf="1"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="user_rfid_tid" string="Primary User TID" optional="show"/>
                <field name="active_user_card_count" optional="show"/>
                <field name="active" readonly="1" optional="hide"/>
                <field name="web_user_id" string="Web Account" optional="hide" groups="base.group_system"/>
                <field name="user_code" string="Technical Code" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_user_form" model="ir.ui.view">
        <field name="name">nsp.user.form</field>
        <field name="model">nsp.user</field>
        <field name="arch" type="xml">
            <form string="User">
                <header>
                    <button name="action_archive" type="object" string="Archive" invisible="not active" class="btn-secondary"/>
                    <button name="action_unarchive" type="object" string="Unarchive" invisible="active" class="btn-primary"/>
                    <field name="active" invisible="1"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="User name"/></h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="RFID Summary">
                            <field name="user_rfid_tid" readonly="1"/>
                            <field name="active_user_card_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="User Cards">
                            <div class="alert alert-info" role="alert">
                                Click <strong>Add a line</strong>, focus <strong>Master Card</strong>, then scan one User Card. A valid scan automatically creates and focuses the next row; an invalid scan stays on the current row and shows the reason.
                            </div>
                            <field name="user_card_ids" context="{'default_user_id': id}">
                                <list editable="bottom" delete="1">
                                    <field name="scan_tid"
                                           string="Master Card"
                                           widget="nsp_rfid_scan"
                                           options="{'target_field': 'card_id', 'resolved_value_field': 'tid', 'expected_card_type': 'user_card', 'require_available': True, 'auto_next_row': True}"
                                           placeholder="Scan User Card TID and press Enter"/>
                                    <field name="card_id" column_invisible="True"/>
                                    <field name="tid" column_invisible="True"/>
                                    <field name="state" widget="badge" readonly="1" decoration-success="state == 'active'" decoration-muted="state == 'revoked'"/>
                                    <field name="assigned_at" optional="hide"/>
                                    <field name="revoked_at" readonly="1" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                    <button name="action_revoke" type="object" string="Revoke" invisible="state != 'active'"/>
                                    <button name="action_activate" type="object" string="Activate" invisible="state != 'revoked'" class="btn-primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Friends" groups="nsp_core.group_nsp_it_parking,base.group_system">
                            <separator string="Accepted Friends"/>
                            <field name="accepted_friendship_ids" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="name" string="Friendship"/>
                                    <field name="accepted_at" optional="show"/>
                                    <button name="action_cancel" type="object" string="Remove"/>
                                </list>
                            </field>
                            <separator string="Sent Requests"/>
                            <field name="friendship_sent_ids" domain="[('state','=','pending')]" context="{'default_requester_id': id}">
                                <list editable="bottom">
                                    <field name="addressee_id" string="Friend" domain="[('id','!=',parent.id)]"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                    <button name="action_cancel" type="object" string="Cancel"/>
                                </list>
                            </field>
                            <separator string="Received Requests"/>
                            <field name="friendship_received_ids" domain="[('state','=','pending')]">
                                <list create="0" delete="0">
                                    <field name="requester_id" string="From"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                    <button name="action_accept" type="object" string="Accept" class="btn-primary"/>
                                    <button name="action_cancel" type="object" string="Decline"/>
                                </list>
                            </field>
                        </page>
                        <page string="Web Access" groups="base.group_system">
                            <group>
                                <group string="Odoo Backend Account">
                                    <field name="web_user_id" options="{'no_create': True}"/>
                                    <button
                                        name="action_open_web_user"
                                        type="object"
                                        string="Open Web Account"
                                        icon="fa-external-link"
                                        class="btn-secondary"
                                        invisible="not web_user_id"
                                    />
                                </group>
                                <group string="Identity Boundary">
                                    <div class="text-muted" colspan="2">
                                        Link an internal Odoo account only when this NSP User needs backend access.
                                        Odoo Web login, Groups, ACLs and Record Rules are managed on the linked Web Account.
                                        RFID, Vehicle, Parking, Mobile and Notification ownership remain on this NSP User.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Note">
                            <field name="note" nolabel="1"/>
                        </page>
                        <page string="Technical" groups="nsp_core.group_nsp_it_parking,base.group_system">
                            <group>
                                <field name="user_code" readonly="1" widget="CopyClipboardChar"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_nsp_user" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">nsp.user</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_user_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
