<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nsp_reference_brand_list" model="ir.ui.view">
        <field name="name">nsp.reference.brand.list</field>
        <field name="model">nsp.reference.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_nsp_reference_brand_form" model="ir.ui.view">
        <field name="name">nsp.reference.brand.form</field>
        <field name="model">nsp.reference.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nsp_reference_brand_search" model="ir.ui.view">
        <field name="name">nsp.reference.brand.search</field>
        <field name="model">nsp.reference.brand</field>
        <field name="arch" type="xml">
            <search string="Brands">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
            </search>
        </field>
    </record>
    <record id="action_nsp_reference_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">nsp.reference.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_reference_brand_search"/>
    </record>

    <record id="view_nsp_reference_model_list" model="ir.ui.view">
        <field name="name">nsp.reference.model.list</field>
        <field name="model">nsp.reference.model</field>
        <field name="arch" type="xml">
            <list string="Models">
                <field name="brand_id"/>
                <field name="name"/>
                <field name="code" string="Technical Code"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_nsp_reference_model_form" model="ir.ui.view">
        <field name="name">nsp.reference.model.form</field>
        <field name="model">nsp.reference.model</field>
        <field name="arch" type="xml">
            <form string="Model">
                <sheet>
                    <group>
                        <field name="brand_id"/>
                        <field name="name"/>
                        <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nsp_reference_model_search" model="ir.ui.view">
        <field name="name">nsp.reference.model.search</field>
        <field name="model">nsp.reference.model</field>
        <field name="arch" type="xml">
            <search string="Models">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
                <field name="brand_id"/>
                <filter string="Brand" name="groupby_brand" context="{'group_by': 'brand_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_nsp_reference_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">nsp.reference.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_reference_model_search"/>
    </record>

    <record id="view_nsp_reference_vendor_list" model="ir.ui.view">
        <field name="name">nsp.reference.vendor.list</field>
        <field name="model">nsp.reference.vendor</field>
        <field name="arch" type="xml">
            <list string="Vendors">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_nsp_reference_vendor_form" model="ir.ui.view">
        <field name="name">nsp.reference.vendor.form</field>
        <field name="model">nsp.reference.vendor</field>
        <field name="arch" type="xml">
            <form string="Vendor">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nsp_reference_vendor_search" model="ir.ui.view">
        <field name="name">nsp.reference.vendor.search</field>
        <field name="model">nsp.reference.vendor</field>
        <field name="arch" type="xml">
            <search string="Vendors">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
            </search>
        </field>
    </record>
    <record id="action_nsp_reference_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">nsp.reference.vendor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_reference_vendor_search"/>
    </record>

    <menuitem id="menu_nsp_reference_data" name="Reference Data" parent="nsp_core.menu_nsp_configuration" sequence="30" groups="nsp_core.group_nsp_hr_parking,nsp_core.group_nsp_it_parking"/>
    <menuitem id="menu_nsp_reference_brands" name="Brands" parent="menu_nsp_reference_data" action="action_nsp_reference_brand" sequence="10" groups="nsp_core.group_nsp_hr_parking,nsp_core.group_nsp_it_parking"/>
    <menuitem id="menu_nsp_reference_models" name="Models" parent="menu_nsp_reference_data" action="action_nsp_reference_model" sequence="20" groups="nsp_core.group_nsp_hr_parking,nsp_core.group_nsp_it_parking"/>
    <menuitem id="menu_nsp_reference_vendors" name="Vendors" parent="menu_nsp_reference_data" action="action_nsp_reference_vendor" sequence="30" groups="nsp_core.group_nsp_it_parking"/>
</odoo>
