<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nsp_master_gatekeeper.CalibrationWorkspace">
        <div class="nsp-cw">
            <div t-if="state.error" class="alert alert-danger" t-esc="state.error"/>

            <div class="nsp-cw__hero">
                <div class="nsp-cw__hero-title">
                    <h2><i class="fa fa-road me-2"/>Lane Calibration</h2>
                    <span t-att-class="resultClass(state.data.status)" t-esc="statusLabel(state.data.status)"/>
                </div>
            </div>

            <div class="nsp-cw__tabs">
                <button t-att-class="tabClass('reference')" t-on-click="() => this.setTab('reference')"><i class="fa fa-repeat me-1"/>Runs</button>
                <button t-att-class="tabClass('validation')" t-on-click="() => this.setTab('validation')"><i class="fa fa-check-circle-o me-1"/>Validation</button>
                <button t-att-class="tabClass('result')" t-on-click="() => this.setTab('result')"><i class="fa fa-line-chart me-1"/>Result</button>
            </div>

            <section t-if="state.activeTab === 'reference'" class="nsp-cw__panel">
                <div class="nsp-cw__section-head">
                    <div><h3>Runs</h3></div>
                    <div class="nsp-cw__actions">
                        <button class="btn btn-primary" title="Start a run" aria-label="Start a run" t-on-click="startReferencePass" t-att-disabled="state.data.running_pass_id"><i class="fa fa-play me-1"/>Start</button>
                        <button class="btn btn-danger" title="Stop and analyse the running run" aria-label="Stop and analyse" t-on-click="stopReferencePass" t-att-disabled="!state.data.running_pass_id"><i class="fa fa-stop me-1"/>Stop</button>
                        <button class="btn btn-outline-primary" title="Build the result from accepted runs" aria-label="Build result" t-on-click="buildResult" t-att-disabled="!state.data.passes?.some((item) => item.state === 'accepted')"><i class="fa fa-calculator me-1"/>Build</button>
                    </div>
                </div>
                <div class="nsp-cw__table-wrap">
                    <table class="table nsp-cw__table">
                        <thead><tr><th>Run</th><th>Started</th><th>Sequence</th><th>Duration</th><th>Result</th><th>State</th><th></th></tr></thead>
                        <tbody>
                            <tr t-foreach="state.data.passes || []" t-as="pass" t-key="pass.id">
                                <td><strong>#<t t-esc="pass.pass_no"/></strong></td>
                                <td t-esc="formatDateTime(pass.started_at)"/>
                                <td><span class="nsp-cw__sequence" t-esc="passSequence(pass)"/></td>
                                <td><t t-esc="formatNumber(pass.total_duration, 3)"/> s</td>
                                <td><span t-att-class="resultClass(pass.result_status)" t-esc="resultLabel(pass.result_status)"/></td>
                                <td><span t-att-class="resultClass(pass.state)" t-esc="statusLabel(pass.state)"/></td>
                                <td class="text-end">
                                    <button t-if="pass.state === 'completed' &amp;&amp; pass.result_status === 'complete'" class="btn btn-sm btn-success me-1" title="Accept run" aria-label="Accept run" t-on-click="() => this.acceptPass(pass.id)"><i class="fa fa-check"/></button>
                                    <button t-if="pass.state !== 'running' &amp;&amp; pass.state !== 'rejected'" class="btn btn-sm btn-outline-danger" title="Reject run" aria-label="Reject run" t-on-click="() => this.rejectPass(pass.id)"><i class="fa fa-times"/></button>
                                </td>
                            </tr>
                            <tr t-if="!state.data.passes?.length"><td colspan="7"><div class="nsp-cw__empty">No runs.</div></td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section t-if="state.activeTab === 'validation'" class="nsp-cw__panel">
                <div class="nsp-cw__section-head">
                    <div><h3>Validation</h3></div>
                    <div class="nsp-cw__run-picker">
                        <label>Run</label>
                        <select class="form-select" t-on-change="selectRun">
                            <option value="">No Run</option>
                            <option t-foreach="state.data.validation_runs || []" t-as="run" t-key="run.id" t-att-value="run.id" t-att-selected="run.id === state.selectedRunId" t-esc="run.name"/>
                        </select>
                        <button t-if="activeRun()" class="btn btn-outline-secondary" title="Open validation" aria-label="Open validation" t-on-click="() => this.openValidationRun(activeRun().id)"><i class="fa fa-external-link"/></button>
                        <button class="btn btn-primary" title="Create validation" aria-label="Create validation" t-on-click="newValidationRun" t-att-disabled="!currentResult() || currentResult().state !== 'validation'"><i class="fa fa-plus me-1"/>New</button>
                    </div>
                </div>

                <t t-if="activeRun()">
                    <div class="nsp-cw__kpi-grid">
                        <div class="nsp-cw-kpi"><span>Vehicles</span><strong t-esc="activeRun().expected_count"/><small>Vehicles</small></div>
                        <div class="nsp-cw-kpi nsp-cw-kpi--success"><span>Complete</span><strong t-esc="activeRun().complete_count"/><small><t t-esc="formatNumber(activeRun().complete_rate, 1)"/>%</small></div>
                        <div class="nsp-cw-kpi nsp-cw-kpi--warning"><span>Incomplete</span><strong t-esc="activeRun().incomplete_count"/><small>With timeouts</small></div>
                        <div class="nsp-cw-kpi nsp-cw-kpi--danger"><span>Missed</span><strong t-esc="activeRun().not_detected_count"/><small>No read</small></div>
                        <div class="nsp-cw-kpi nsp-cw-kpi--purple"><span>Order Errors</span><strong t-esc="activeRun().wrong_order_count"/><small><t t-esc="formatNumber(activeRun().wrong_order_rate, 1)"/>%</small></div>
                        <div class="nsp-cw-kpi nsp-cw-kpi--success"><span>Rate</span><strong><t t-esc="formatNumber(activeRun().complete_rate, 1)"/>%</strong><small>Target ≥ <t t-esc="activeRun().minimum_complete_rate"/>%</small></div>
                    </div>

                    <div class="nsp-cw__analytics-grid">
                        <div class="nsp-cw-card">
                            <h4>Results</h4>
                            <div class="nsp-cw__donut-row">
                                <div class="nsp-cw__donut" t-att-style="distributionStyle()"><div><strong t-esc="activeRun().expected_count"/><span>Total</span></div></div>
                                <div class="nsp-cw__legend">
                                    <div><i class="is-complete"/>Complete <strong t-esc="activeRun().complete_count"/></div>
                                    <div><i class="is-incomplete"/>Incomplete <strong t-esc="activeRun().incomplete_count"/></div>
                                    <div><i class="is-missing"/>Missed <strong t-esc="activeRun().not_detected_count"/></div>
                                    <div><i class="is-wrong"/>Order Errors <strong t-esc="activeRun().wrong_order_count"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="nsp-cw-card nsp-cw-card--wide">
                            <h4>Reader Ports</h4>
                            <div class="nsp-cw__port-bars">
                                <div t-foreach="activeRun().port_stats || []" t-as="stat" t-key="(stat.reader_code || stat.reader_serial_number) + '-' + stat.port_no" class="nsp-cw__port-bar">
                                    <div class="nsp-cw__bar-track"><span t-att-style="'width:' + portWidth(stat)"/></div>
                                    <div><strong><t t-esc="stat.reader_code || stat.reader_serial_number"/>:<t t-esc="stat.port_no"/></strong><span><t t-esc="formatNumber(stat.detection_rate, 1)"/>%</span></div>
                                </div>
                                <div t-if="!activeRun().port_stats?.length" class="nsp-cw__empty">Complete validation to calculate Reader Port statistics.</div>
                            </div>
                        </div>
                    </div>

                    <div class="nsp-cw__detail-grid">
                        <div class="nsp-cw-card nsp-cw-card--table">
                            <h4>Vehicles</h4>
                            <div class="nsp-cw__table-wrap">
                                <table class="table nsp-cw__table nsp-cw__table--compact">
                                    <thead><tr><th>Re-test</th><th>#</th><th>License Plate</th><th>RFID Tag</th><th>Detected Sequence</th><th>Result</th><th>Missing / Error</th><th>Total Time</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="activeRun().vehicles || []" t-as="vehicle" t-key="vehicle.id">
                                            <td><input type="checkbox" class="form-check-input" t-att-checked="vehicle.retry_selected" t-on-change="(ev) => this.toggleRetestVehicle(vehicle.id, ev)"/></td>
                                            <td t-esc="vehicle.id"/>
                                            <td><strong t-esc="vehicle.license_plate"/></td>
                                            <td class="nsp-cw__mono" t-esc="vehicle.vehicle_tid"/>
                                            <td><span class="nsp-cw__sequence" t-esc="vehicle.detected_sequence || '—'"/></td>
                                            <td><span t-att-class="resultClass(vehicle.result)" t-esc="resultLabel(vehicle.result)"/></td>
                                            <td t-esc="vehicle.missing_or_error || '—'"/>
                                            <td><t t-esc="formatNumber(vehicle.total_duration, 3)"/> s</td>
                                        </tr>
                                        <tr t-if="!activeRun().vehicles?.length"><td colspan="8"><div class="nsp-cw__empty">No Vehicles.</div></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="nsp-cw-card nsp-cw-card--table">
                            <h4>Durations</h4>
                            <div class="nsp-cw__table-wrap">
                                <table class="table nsp-cw__table nsp-cw__table--compact">
                                    <thead><tr><th>Transition</th><th>Samples</th><th>Min</th><th>Median</th><th>Average</th><th>P95</th><th>Max</th><th>Timeouts</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="activeRun().transition_stats || []" t-as="stat" t-key="stat.transition">
                                            <td><strong t-esc="stat.transition"/></td><td t-esc="stat.sample_count"/>
                                            <td t-esc="formatNumber(stat.duration_min, 3)"/><td t-esc="formatNumber(stat.duration_median, 3)"/>
                                            <td t-esc="formatNumber(stat.duration_average, 3)"/><td t-esc="formatNumber(stat.duration_p95, 3)"/>
                                            <td t-esc="formatNumber(stat.duration_max, 3)"/><td t-esc="stat.timeout_count"/>
                                        </tr>
                                        <tr t-if="!activeRun().transition_stats?.length"><td colspan="8"><div class="nsp-cw__empty">No duration data.</div></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="nsp-cw__bottom-grid">
                        <div class="nsp-cw-card">
                            <h4>Test</h4>
                            <div class="nsp-cw__actions">
                                <button t-if="activeRun().state === 'draft'" class="btn btn-primary" title="Start validation" t-on-click="() => this.startValidation(activeRun().id)"><i class="fa fa-play me-1"/>Start</button>
                                <button t-if="activeRun().state === 'running'" class="btn btn-danger" title="Stop and analyse" t-on-click="() => this.stopValidation(activeRun().id)"><i class="fa fa-stop me-1"/>Stop</button>
                                <button t-if="['passed','failed','completed'].includes(activeRun().state)" class="btn btn-outline-primary" title="New run for all Vehicles" t-on-click="() => this.newRunAll(activeRun().id)"><i class="fa fa-plus me-1"/>All</button>
                                <button t-if="['passed','failed','completed'].includes(activeRun().state)" class="btn btn-outline-secondary" title="Re-test failed Vehicles" t-on-click="() => this.retestFailed(activeRun().id)"><i class="fa fa-repeat me-1"/>Failed</button>
                                <button t-if="['passed','failed','completed'].includes(activeRun().state)" class="btn btn-outline-secondary" title="Re-test selected Vehicles" t-on-click="() => this.retestSelected(activeRun().id)"><i class="fa fa-check-square-o me-1"/>Selected</button>
                            </div>
                        </div>
                        <div class="nsp-cw-card nsp-cw-card--recommendation">
                            <h4>Advice</h4>
                            <p t-esc="activeRun().recommendation || 'Complete validation to generate advice.'"/>
                        </div>
                    </div>
                </t>
                <div t-else="" class="nsp-cw__empty nsp-cw__empty--large">No validation.</div>
            </section>

            <section t-if="state.activeTab === 'result'" class="nsp-cw__panel">
                <div class="nsp-cw__section-head">
                    <div><h3>Result</h3></div>
                    <div class="nsp-cw__actions">
                        <button class="btn btn-outline-primary" title="Rebuild result" t-on-click="buildResult"><i class="fa fa-refresh me-1"/>Build</button>
                        <button t-if="currentResult()?.state === 'draft'" class="btn btn-primary" title="Send result to validation" t-on-click="() => this.submitResultValidation(currentResult().id)"><i class="fa fa-flask me-1"/>Validate</button>
                        <button t-if="currentResult()?.state === 'validation' &amp;&amp; currentResult()?.validation_state === 'passed'" class="btn btn-success" title="Accept this result" t-on-click="() => this.publishResult(currentResult().id)"><i class="fa fa-check me-1"/>Accept</button>
                    </div>
                </div>
                <t t-if="currentResult()">
                    <div class="nsp-cw__result-summary">
                        <div><span>Code</span><strong t-esc="currentResult().name"/></div>
                        <div><span>Path</span><strong t-esc="currentResult().path_display"/></div>
                        <div><span>Duration</span><strong><t t-esc="formatNumber(currentResult().total_duration, 3)"/> s</strong></div>
                        <div><span>Runs</span><strong t-esc="currentResult().accepted_pass_count"/></div>
                        <div><span>Tolerance</span><strong>± <t t-esc="formatNumber(currentResult().tolerance_percent, 1)"/>%</strong></div>
                        <div><span>State</span><strong><span t-att-class="resultClass(currentResult().state)" t-esc="statusLabel(currentResult().state)"/></strong></div>
                        <div><span>Validation</span><strong><span t-att-class="resultClass(currentResult().validation_state)" t-esc="statusLabel(currentResult().validation_state)"/></strong></div>
                    </div>
                    <div class="nsp-cw__table-wrap">
                        <table class="table nsp-cw__table">
                            <thead><tr><th>Order</th><th>Reader</th><th>Port</th><th>Duration</th><th>Samples</th><th>P95</th><th>Cumulative</th></tr></thead>
                            <tbody><tr t-foreach="currentResult().lines || []" t-as="line" t-key="line.sequence">
                                <td><span class="nsp-cw__order" t-esc="line.sequence"/></td>
                                <td class="nsp-cw__mono" t-esc="line.reader"/><td t-esc="line.port_no"/>
                                <td><t t-esc="formatNumber(line.duration_standard, 3)"/> s</td><td><t t-esc="line.sample_count"/> Runs</td>
                                <td><t t-esc="formatNumber(line.duration_p95, 3)"/> s</td><td><t t-esc="formatNumber(line.cumulative_time, 3)"/> s</td>
                            </tr></tbody>
                        </table>
                    </div>
                </t>
                <div t-else="" class="nsp-cw__empty nsp-cw__empty--large">Accept consistent runs, then build the result.</div>
            </section>

        </div>
    </t>
</templates>
