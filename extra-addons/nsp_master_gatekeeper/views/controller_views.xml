<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_nsp_edge_servers_search" model="ir.ui.view">
        <field name="name">nsp.edge.server.search</field>
        <field name="model">nsp.edge.server</field>
        <field name="arch" type="xml">
            <search string="Edge Servers">
                <field name="name"/>
                <field name="edge_server_code" string="Technical Code" optional="hide"/>
                <filter string="Online" name="online" domain="[('status','=','online')]"/>
                <filter string="Offline" name="offline" domain="[('status','=','offline')]"/>
                <filter string="Error" name="error" domain="[('status','=','error')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_nsp_edge_servers_list" model="ir.ui.view">
        <field name="name">nsp.edge.server.list</field>
        <field name="model">nsp.edge.server</field>
        <field name="arch" type="xml">
            <list string="Edge Servers" create="0" edit="1" delete="0">
                <field name="status" widget="badge" decoration-success="status == 'online'" decoration-danger="status in ('offline','revoked')" decoration-warning="status in ('error','block')"/>
                <field name="name"/>
                <field name="edge_server_code" string="Technical Code" optional="hide"/>
                <field name="controller_count"/>
                <field name="reader_count"/>
                <field name="antenna_count"/>
                <field name="timestamp" string="Last Heartbeat"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_edge_servers_form" model="ir.ui.view">
        <field name="name">nsp.edge.server.form</field>
        <field name="model">nsp.edge.server</field>
        <field name="arch" type="xml">
            <form string="Edge Server" create="0" edit="1" delete="0">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="offline,online,error,block,revoked" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Main Edge Server"/></h1>
                    </div>
                    <group>
                        <group string="Edge Server Declaration">
                            <field name="active"/>
                            <field name="edge_server_code" string="Technical Code" readonly="1" widget="CopyClipboardChar" groups="nsp_core.group_nsp_it_parking"/>
                        </group>
                        <group string="Runtime Status">
                            <field name="status" widget="badge" readonly="1" decoration-success="status == 'online'" decoration-danger="status in ('offline','revoked')" decoration-warning="status in ('error','block')"/>
                            <field name="timestamp" string="Last Heartbeat" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="infrastructure" string="Infrastructure">
                            <div class="alert alert-info" role="alert">
                                Configure infrastructure in ownership order: Edge Server → Controller → Reader → Antenna. Create each Reader from its Controller and each Antenna from its Reader so parent relations are assigned automatically.
                            </div>
                            <div class="text-muted mb-2">
                                Use Add a line to open the Controller popup. Inside it, add Readers directly in the list and declare their Antenna numbers on the same line.
                            </div>
                            <field name="controller_ids" mode="list,form" context="{'default_edge_server_id': id, 'form_view_ref': 'nsp_master_gatekeeper.view_nsp_controllers_form'}">
                                <list string="Controllers" create="0" edit="1" delete="0">
                                    <control>
                                        <create string="Add a line"/>
                                    </control>
                                    <field name="controller_name" string="Controller"/>
                                    <field name="controller_id" string="Technical Code" optional="hide" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="status" widget="badge" readonly="1"/>
                                    <field name="reader_count" readonly="1"/>
                                    <field name="antenna_count" readonly="1"/>
                                    <field name="timestamp" string="Last Heartbeat" readonly="1" optional="hide"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nsp_controllers_search" model="ir.ui.view">
        <field name="name">nsp.controller.search</field>
        <field name="model">nsp.controller</field>
        <field name="arch" type="xml">
            <search string="Controllers">
                <field name="controller_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="controller_name"/>
                <field name="edge_server_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <filter string="Online" name="online" domain="[('status','=','online')]"/>
                <filter string="Offline" name="offline" domain="[('status','=','offline')]"/>
                <filter string="Error" name="error" domain="[('status','=','error')]"/>
                <separator/>
                <group>
                    <filter string="Edge Server" name="group_edge" context="{'group_by':'edge_server_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_nsp_controllers_list" model="ir.ui.view">
        <field name="name">nsp.controller.list</field>
        <field name="model">nsp.controller</field>
        <field name="arch" type="xml">
            <list string="Controllers" create="0" edit="1" delete="0">
                <field name="status" widget="badge" decoration-success="status == 'online'" decoration-danger="status in ('offline','revoked')" decoration-warning="status in ('error','block')"/>
                <field name="controller_name" string="Controller" decoration-bf="1"/>
                <field name="controller_id" string="Technical Code" optional="hide" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="edge_server_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="reader_count"/>
                <field name="antenna_count"/>
                <field name="timestamp" string="Last Heartbeat"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_controllers_form" model="ir.ui.view">
        <field name="name">nsp.controller.form</field>
        <field name="model">nsp.controller</field>
        <field name="arch" type="xml">
            <form string="Controller" create="0" edit="1" delete="0">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="offline,online,error,block,revoked" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="controller_name"/>
                        <h1><field name="controller_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Controller Declaration">
                            <field name="edge_server_id" readonly="context.get('default_edge_server_id')" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" context="{'form_view_ref': 'nsp_master_gatekeeper.view_nsp_edge_servers_form'}"/>
                            <field name="active"/>
                            <field name="controller_id" string="Technical Code" readonly="1" widget="CopyClipboardChar" groups="nsp_core.group_nsp_it_parking" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        </group>
                        <group string="Runtime Status">
                            <field name="status" widget="badge" readonly="1" decoration-success="status == 'online'" decoration-danger="status in ('offline','revoked')" decoration-warning="status in ('error','block')"/>
                            <field name="timestamp" string="Last Heartbeat" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="readers" string="Readers">
                            <div class="alert alert-info" role="alert">
                                Every Reader belongs to this Controller. Create Antennas from the owning Reader; do not create standalone Antennas.
                            </div>
                            <div class="text-muted mb-2">
                                Use Add a line to enter Reader information directly. Enter Antenna Nos. as 1,2,3,4 or 1-4; the Antenna records are created automatically when the Controller is saved.
                            </div>
                            <field name="device_ids" context="{'default_controller_id': id, 'default_edge_server_id': edge_server_id}">
                                <list string="Readers" create="0" edit="1" delete="0" open_form_view="0">
                                    <control>
                                        <create string="Add a line"/>
                                    </control>
                                    <field name="name" string="Reader" required="1"/>
                                    <field name="serial_number" string="Serial" required="1"/>
                                    <field name="connection_type" string="Physical Connection" widget="nsp_grouped_connection" optional="show"/>
                                    <field name="antenna_numbers" string="Antenna Nos." placeholder="1-4" optional="show"/>
                                    <field name="device_code" string="Technical Code" readonly="1" optional="hide"/>
                                    <field name="status" widget="badge" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                </footer>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_nsp_edge_servers" model="ir.actions.act_window">
        <field name="name">Edge Servers</field>
        <field name="res_model">nsp.edge.server</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_edge_servers_search"/>
    </record>

    <record id="action_nsp_controllers" model="ir.actions.act_window">
        <field name="name">Controllers</field>
        <field name="res_model">nsp.controller</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_controllers_search"/>
    </record>

    <record id="action_nsp_controllers_configuration" model="ir.actions.act_window">
        <field name="name">Controllers</field>
        <field name="res_model">nsp.controller</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_controllers_search"/>
    </record>
</odoo>
