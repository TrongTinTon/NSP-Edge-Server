<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_nsp_measurement_session_search" model="ir.ui.view">
        <field name="name">nsp.measurement.session.search</field>
        <field name="model">nsp.measurement.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="measurement_code" string="Calibration Code"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="Ready" name="ready" domain="[('status','=','ready')]"/>
                <filter string="Running" name="running" domain="[('status','=','running')]"/>
                <filter string="Completed" name="completed" domain="[('status','=','completed')]"/>
                <filter string="Applied" name="applied" domain="[('status','=','applied')]"/>
                <filter string="Failed" name="failed" domain="[('status','=','failed')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_nsp_measurement_session_list" model="ir.ui.view">
        <field name="name">nsp.measurement.session.list</field>
        <field name="model">nsp.measurement.session</field>
        <field name="arch" type="xml">
            <list string="Reader Calibration" decoration-info="status == 'running'" decoration-success="status in ('completed','applied')" decoration-danger="status == 'failed'">
                <field name="measurement_code" readonly="1"/>
                <field name="revision"/>
                <field name="target_count" string="Target Pairs"/>
                <field name="controller_count" string="Controllers"/>
                <field name="reader_count" string="Readers"/>
                <field name="status" widget="badge"/>
                <field name="event_count" string="Current Reads"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_measurement_session_form" model="ir.ui.view">
        <field name="name">nsp.measurement.session.form</field>
        <field name="model">nsp.measurement.session</field>
        <field name="arch" type="xml">
            <form string="Reader Calibration">
                <header>
                    <button name="action_ready" type="object" string="Release to Controllers" icon="fa-cloud-upload" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_open_live" type="object" string="Live Reader Calibration" icon="fa-line-chart" class="oe_highlight" invisible="status == 'draft'"/>
                    <button name="action_complete" type="object" string="Complete" icon="fa-check-circle" invisible="status != 'running'"/>
                    <button name="action_cancel" type="object" string="Cancel" icon="fa-times-circle" invisible="status in ('completed','applied','failed','cancelled')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,ready,running,completed,applied"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_events" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <field name="event_count" widget="statinfo" string="Current Reads"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="measurement_code" string="Calibration Code"/>
                        <h1><field name="measurement_code" readonly="1" widget="CopyClipboardChar"/></h1>
                        <div class="text-muted">Revision <field name="revision" readonly="1" class="oe_inline"/></div>
                    </div>
                    <group>
                        <group string="Calibration Scope">
                            <field name="target_count" string="Target Pairs" readonly="1"/>
                            <field name="target_tag_count" string="RFID Tags" readonly="1"/>
                            <field name="controller_count" readonly="1"/>
                            <field name="reader_count" readonly="1"/>
                        </group>
                        <group string="Schedule">
                            <field name="planned_start_at" readonly="status != 'draft'"/>
                            <field name="planned_end_at" readonly="status != 'draft'"/>
                            <field name="started_at" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                            <field name="applied_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Target Pairs">
                            <div class="alert alert-info" role="alert">
                                One line represents one person and one vehicle. Scan, paste, or type the Employee RFID Tag, then the Vehicle RFID Tag. A valid value shows a green border; an invalid value shows a red border and the reason. The License Plate is resolved automatically from the active Vehicle RFID Tag assignment.
                            </div>
                            <field name="target_line_ids" readonly="status != 'draft'">
                                <list editable="bottom" delete="1">
                                    <field name="user_scan_tid" string="Employee RFID Tag" widget="nsp_rfid_scan" options="{'target_field': 'user_assignment_id', 'resolved_value_field': 'user_tid', 'expected_target': 'user', 'require_available': False, 'require_active_assignment': True, 'skip_duplicates': True, 'next_scan_field': 'vehicle_scan_tid'}" placeholder="Scan or paste User RFID TID"/>
                                    <field name="user_assignment_id" column_invisible="True"/>
                                    <field name="user_tid" column_invisible="True"/>
                                    <field name="user_id" column_invisible="True"/>
                                    <field name="vehicle_scan_tid" string="Vehicle RFID Tag" widget="nsp_rfid_scan" options="{'target_field': 'vehicle_assignment_id', 'resolved_value_field': 'vehicle_tid', 'expected_target': 'vehicle', 'require_available': False, 'require_active_assignment': True, 'skip_duplicates': True, 'auto_next_row': True}" placeholder="Scan or paste Vehicle RFID TID"/>
                                    <field name="vehicle_assignment_id" column_invisible="True"/>
                                    <field name="vehicle_tid" column_invisible="True"/>
                                    <field name="vehicle_id" column_invisible="True"/>
                                    <field name="license_plate" string="License Plate" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Controllers &amp; Readers">
                            <div class="alert alert-info" role="alert">
                                Select Readers from one or many Controllers. Reader ownership determines the Controller automatically. Choose only the Antennas that participate in this calibration.
                            </div>
                            <field name="reader_line_ids" readonly="status != 'draft'">
                                <list editable="bottom" delete="1">
                                    <field name="controller_id" readonly="1"/>
                                    <field name="reader_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" context="{'form_view_ref': 'nsp_master_gatekeeper.nsp_device_view_form'}" domain="[('active','=',True),('whitelist_id.active','=',True),('whitelist_id.device_type_code','=','RFID_READER')]"/>
                                    <field name="serial_number" readonly="1" optional="hide"/>
                                    <field name="reader_status" readonly="1" widget="badge"/>
                                    <field name="reader_power_dbm" string="Reader Power (dBm)"/>
                                    <field name="read_interval_ms" string="Read Interval ms"/>
                                    <field name="available_antenna_ids" column_invisible="True"/>
                                    <field name="antenna_ids" string="Antennas" widget="many2many_tags" domain="[('id','in',available_antenna_ids)]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" required="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Test plan, operating conditions, or acceptance criteria" readonly="status not in ('draft','completed')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_nsp_measurement_session_live_form" model="ir.ui.view">
        <field name="name">nsp.measurement.session.live.form</field>
        <field name="model">nsp.measurement.session</field>
        <field name="arch" type="xml">
            <form string="Live Reader Calibration" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_open_session_form" type="object" string="Configuration" icon="fa-arrow-left"/>
                    <button name="action_view_events" type="object" string="Observations" icon="fa-list-ol"/>
                    <button name="action_live_measure_again" type="object" string="Measure Again" icon="fa-repeat" invisible="status not in ('running','completed','failed')"/>
                    <button name="action_live_complete" type="object" string="Complete" icon="fa-check-circle" class="oe_highlight" invisible="status != 'running'"/>
                    <button name="action_live_apply_to_operation" type="object" string="Apply to Operation" icon="fa-check" class="oe_highlight" invisible="not is_cloud_deployment or status != 'completed'"/>
                    <button name="action_live_cancel" type="object" string="Cancel" icon="fa-times-circle" invisible="status not in ('ready','running')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,ready,running,completed,applied,failed,cancelled"/>
                </header>
                <sheet class="nsp-measurement-live-form">
                    <field name="is_cloud_deployment" invisible="1"/>
                    <div class="oe_title">
                        <label for="measurement_code" string="Live Reader Calibration"/>
                        <h1><field name="measurement_code" readonly="1" widget="CopyClipboardChar"/></h1>
                    </div>
                    <group class="nsp-measurement-live-meta">
                        <field name="revision" readonly="1"/>
                        <field name="target_count" string="Target Pairs" readonly="1"/>
                        <field name="controller_count" readonly="1"/>
                        <field name="reader_count" readonly="1"/>
                    </group>
                    <field name="live_dashboard" widget="nsp_master_measurement_live_dashboard" nolabel="1" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nsp_measurement_event_search" model="ir.ui.view">
        <field name="name">nsp.measurement.event.search</field>
        <field name="model">nsp.measurement.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_uid"/>
                <field name="session_id"/>
                <field name="revision"/>
                <field name="serial_number"/>
                <field name="antenna_no"/>
                <field name="tid"/>
                <filter string="Session" name="group_session" context="{'group_by':'session_id'}"/>
                <filter string="Revision" name="group_revision" context="{'group_by':'revision'}"/>
                <filter string="RFID Tag" name="group_tid" context="{'group_by':'tid'}"/>
                <filter string="Reader" name="group_reader" context="{'group_by':'serial_number'}"/>
                <filter string="Antenna" name="group_antenna" context="{'group_by':'antenna_no'}"/>
            </search>
        </field>
    </record>

    <record id="view_nsp_measurement_event_list" model="ir.ui.view">
        <field name="name">nsp.measurement.event.list</field>
        <field name="model">nsp.measurement.event</field>
        <field name="arch" type="xml">
            <list string="Calibration Observations" create="0" edit="0" delete="0">
                <field name="read_at"/>
                <field name="session_id"/>
                <field name="revision"/>
                <field name="tid"/>
                <field name="serial_number"/>
                <field name="antenna_no"/>
                <field name="power_dbm" optional="hide"/>
                <field name="read_interval_ms" optional="hide"/>
                <field name="rssi_dbm" optional="hide"/>
                <field name="event_uid" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_measurement_event_form" model="ir.ui.view">
        <field name="name">nsp.measurement.event.form</field>
        <field name="model">nsp.measurement.event</field>
        <field name="arch" type="xml">
            <form string="Calibration Observation" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="event_uid"/>
                        <field name="session_id"/>
                        <field name="revision"/>
                        <field name="tid"/>
                        <field name="serial_number"/>
                        <field name="antenna_no"/>
                        <field name="read_at"/>
                        <field name="power_dbm"/>
                        <field name="read_interval_ms"/>
                        <field name="rssi_dbm"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_measurement_session" model="ir.actions.act_window">
        <field name="name">Reader Calibration</field>
        <field name="res_model">nsp.measurement.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_measurement_session_search"/>
    </record>

    <record id="action_nsp_measurement_event" model="ir.actions.act_window">
        <field name="name">Calibration Observations</field>
        <field name="res_model">nsp.measurement.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_measurement_event_search"/>
    </record>
</odoo>
