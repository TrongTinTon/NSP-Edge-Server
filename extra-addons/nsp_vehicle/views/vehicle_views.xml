<odoo>
    <record id="view_nsp_vehicle_search" model="ir.ui.view">
        <field name="name">nsp.vehicle.search</field>
        <field name="model">nsp.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="license_plate"/>
                <field name="owner_id" string="Owner"/>
                <field name="tid"/>
                <field name="vehicle_type_id"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="color_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Vehicle Type" name="groupby_type" context="{'group_by':'vehicle_type_id'}"/>
                <filter string="Owner" name="groupby_owner" context="{'group_by':'owner_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_nsp_vehicle_list" model="ir.ui.view">
        <field name="name">nsp.vehicle.list</field>
        <field name="model">nsp.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="image_128" string="Photo" widget="image" class="o_avatar" optional="show"/>
                <field name="license_plate" decoration-bf="1"/>
                <field name="owner_id" string="Owner"/>
                <field name="vehicle_type_id"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="color_id" optional="hide"/>
                <field name="tid" string="Primary TID"/>
                <field name="active_vehicle_card_count" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_vehicle_form" model="ir.ui.view">
        <field name="name">nsp.vehicle.form</field>
        <field name="model">nsp.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <button name="action_archive" type="object" string="Archive" invisible="not active" class="btn-secondary"/>
                    <button name="action_unarchive" type="object" string="Unarchive" invisible="active" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="license_plate" string="License Plate"/>
                        <h1><field name="license_plate"/></h1>
                    </div>
                    <group>
                        <group string="Vehicle">
                            <field name="active"/>
                            <field name="owner_id" string="Owner"/>
                            <field name="vehicle_type_id" options="{'no_create': False, 'no_quick_create': False}"/>
                            <field name="brand_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="model_id" domain="[('brand_id', '=', brand_id)]" options="{'no_create': True, 'no_open': False}"/>
                            <field name="color_id" options="{'no_create': False, 'no_quick_create': False}"/>
                        </group>
                        <group string="RFID Summary">
                            <field name="tid" string="Primary Active TID" readonly="1"/>
                            <field name="active_vehicle_card_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vehicle Cards">
                            <div class="alert alert-info" role="alert">
                                Click <strong>Add a line</strong>, focus <strong>Master Card</strong>, then scan one Vehicle Card. A valid scan automatically creates and focuses the next row; an invalid scan stays on the current row and shows the reason.
                            </div>
                            <field name="vehicle_card_ids" context="{'default_vehicle_id': id}">
                                <list editable="bottom">
                                    <field name="scan_tid"
                                           string="Master Card"
                                           widget="nsp_rfid_scan"
                                           options="{'target_field': 'card_id', 'resolved_value_field': 'tid', 'expected_card_type': 'vehicle_card', 'require_available': True, 'auto_next_row': True}"
                                           placeholder="Scan Vehicle Card TID and press Enter"/>
                                    <field name="card_id" column_invisible="True"/>
                                    <field name="tid" column_invisible="True"/>
                                    <field name="state" widget="badge" readonly="1" decoration-success="state == 'active'" decoration-muted="state == 'revoked'"/>
                                    <field name="assigned_at" optional="hide"/>
                                    <field name="revoked_at" optional="hide" readonly="1"/>
                                    <button name="action_revoke" type="object" string="Revoke" invisible="state != 'active'"/>
                                    <button name="action_activate" type="object" string="Activate" invisible="state != 'revoked'" class="btn-primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Authorized Users">
                            <div class="alert alert-info" role="alert">
                                Add an accepted friend here to grant temporary use of this vehicle. The permission is active immediately for the selected time window; no approval workflow is required.
                            </div>
                            <field name="borrow_ids" context="{'default_vehicle_id': id}">
                                <list editable="bottom" decoration-success="active_now" decoration-muted="state in ('returned','cancelled')">
                                    <field name="allowed_borrower_ids" column_invisible="1"/>
                                    <field name="borrower_id" string="Authorized User" domain="[('id','in',allowed_borrower_ids)]"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                    <field name="active_now" widget="boolean" readonly="1"/>
                                    <button name="action_return_vehicle" type="object" string="End" invisible="state != 'active'"/>
                                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'active'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" groups="nsp_core.group_nsp_it_parking">
                            <group>
                                <field name="vehicle_code" readonly="1" widget="CopyClipboardChar"/>
                                <field name="vehicle_tid_tids" string="All Active Vehicle TIDs" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_nsp_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">nsp.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_vehicle_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
