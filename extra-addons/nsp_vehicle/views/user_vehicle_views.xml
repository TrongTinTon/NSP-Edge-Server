<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nsp_user_vehicle_management_form" model="ir.ui.view">
        <field name="name">nsp.user.vehicle.management.form</field>
        <field name="model">nsp.user</field>
        <field name="inherit_id" ref="nsp_user.view_nsp_user_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="employee_rfid_tag" string="Employee RFID Tag">
                    <field name="employee_tid_input" placeholder="Scan or enter Employee TID"/>
                    <field name="employee_tid" readonly="1"/>
                    <button name="action_revoke_employee_tag" type="object" string="Revoke Employee Tag"
                            invisible="not employee_tag_assignment_id" class="btn-secondary"/>
                    <field name="employee_tag_assignment_id" invisible="1"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Vehicles" name="nsp_user_vehicles">
                    <div class="alert alert-info" role="alert">
                        Create vehicles directly for this User. Each Vehicle accepts one active RFID TID.
                        Revoke the current assignment before assigning another tag.
                    </div>
                    <field name="vehicle_ids" context="{'default_owner_id': id}">
                        <list editable="bottom" open_form_view="1" delete="0">
                            <field name="license_plate"/>
                            <field name="vehicle_type_id" optional="show"/>
                            <field name="brand_id" optional="show"/>
                            <field name="model_id" domain="[('brand_id', '=', brand_id)]" optional="show"/>
                            <field name="color_id" optional="hide"/>
                            <field name="rfid_tid_input" string="RFID TID" placeholder="Scan or enter Vehicle TID"/>
                            <field name="tid" readonly="1" optional="hide"/>
                            <field name="active" widget="boolean_toggle" optional="hide"/>
                            <button name="action_revoke_rfid_tag" type="object" string="Revoke Tag"
                                    invisible="not active_tag_assignment_id"/>
                            <field name="active_tag_assignment_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_nsp_user_vehicle_management_list" model="ir.ui.view">
        <field name="name">nsp.user.vehicle.management.list</field>
        <field name="model">nsp.user</field>
        <field name="inherit_id" ref="nsp_user.view_nsp_user_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="employee_tid" string="Employee TID" optional="show"/>
                <field name="vehicle_count" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
