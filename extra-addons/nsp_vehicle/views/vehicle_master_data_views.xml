<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nsp_vehicle_type_list" model="ir.ui.view">
        <field name="name">nsp.vehicle.type.list</field>
        <field name="model">nsp.vehicle.type</field>
        <field name="arch" type="xml">
            <list string="Vehicle Types">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_nsp_vehicle_type_form" model="ir.ui.view">
        <field name="name">nsp.vehicle.type.form</field>
        <field name="model">nsp.vehicle.type</field>
        <field name="arch" type="xml">
            <form string="Vehicle Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nsp_vehicle_type_search" model="ir.ui.view">
        <field name="name">nsp.vehicle.type.search</field>
        <field name="model">nsp.vehicle.type</field>
        <field name="arch" type="xml">
            <search string="Vehicle Types">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
            </search>
        </field>
    </record>
    <record id="action_nsp_vehicle_type" model="ir.actions.act_window">
        <field name="name">Vehicle Types</field>
        <field name="res_model">nsp.vehicle.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_vehicle_type_search"/>
    </record>

    <record id="view_nsp_vehicle_color_list" model="ir.ui.view">
        <field name="name">nsp.vehicle.color.list</field>
        <field name="model">nsp.vehicle.color</field>
        <field name="arch" type="xml">
            <list string="Colors">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_nsp_vehicle_color_form" model="ir.ui.view">
        <field name="name">nsp.vehicle.color.form</field>
        <field name="model">nsp.vehicle.color</field>
        <field name="arch" type="xml">
            <form string="Color">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nsp_vehicle_color_search" model="ir.ui.view">
        <field name="name">nsp.vehicle.color.search</field>
        <field name="model">nsp.vehicle.color</field>
        <field name="arch" type="xml">
            <search string="Colors">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
            </search>
        </field>
    </record>
    <record id="action_nsp_vehicle_color" model="ir.actions.act_window">
        <field name="name">Colors</field>
        <field name="res_model">nsp.vehicle.color</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_vehicle_color_search"/>
    </record>
</odoo>
