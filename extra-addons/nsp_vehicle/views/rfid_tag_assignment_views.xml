<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nsp_rfid_tag_assignment_form" model="ir.ui.view">
        <field name="name">nsp.rfid.tag.assignment.form</field>
        <field name="model">nsp.rfid.tag.assignment</field>
        <field name="arch" type="xml">
            <form string="RFID Tag Assignment" create="0" delete="0">
                <header>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="state != 'active'" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,revoked" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tag_id" readonly="1"/>
                            <field name="user_id" readonly="1" invisible="not user_id"/>
                            <field name="vehicle_id" readonly="1" invisible="not vehicle_id"/>
                        </group>
                        <group string="Audit">
                            <field name="assigned_at" readonly="1"/>
                            <field name="assigned_by_id" readonly="1"/>
                            <field name="revoked_at" readonly="1"/>
                            <field name="revoked_by_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
