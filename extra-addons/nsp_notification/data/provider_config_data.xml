<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="nsp_notification_provider_config_default" model="nsp.notification.provider.config">
        <field name="name">Mobile Push Providers</field>
        <field name="active">True</field>
        <field name="max_attempts">5</field>
        <field name="retry_delay_seconds">60</field>
        <field name="request_timeout_seconds">15</field>
    </record>

    <record id="ir_cron_nsp_notification_dispatch" model="ir.cron">
        <field name="name">NSP Notification Push Dispatcher</field>
        <field name="model_id" ref="model_nsp_notification_delivery"/>
        <field name="state">code</field>
        <field name="code">model.cron_dispatch_pending(limit=100)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
