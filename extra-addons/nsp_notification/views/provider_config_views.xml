<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nsp_notification_provider_config_form" model="ir.ui.view">
        <field name="name">nsp.notification.provider.config.form</field>
        <field name="model">nsp.notification.provider.config</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Firebase Cloud Messaging">
                            <field name="fcm_enabled"/>
                            <field name="fcm_project_id" invisible="not fcm_enabled" required="fcm_enabled"/>
                            <field name="fcm_service_account_json" invisible="not fcm_enabled" required="fcm_enabled" password="True"/>
                        </group>
                        <group string="Apple Push Notification Service">
                            <field name="apns_enabled"/>
                            <field name="apns_team_id" invisible="not apns_enabled" required="apns_enabled"/>
                            <field name="apns_key_id" invisible="not apns_enabled" required="apns_enabled"/>
                            <field name="apns_topic" invisible="not apns_enabled" required="apns_enabled"/>
                            <field name="apns_private_key" invisible="not apns_enabled" required="apns_enabled" password="True"/>
                            <field name="apns_sandbox" invisible="not apns_enabled"/>
                        </group>
                    </group>
                    <group string="Delivery Policy">
                        <field name="max_attempts"/>
                        <field name="retry_delay_seconds"/>
                        <field name="request_timeout_seconds"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_notification_provider_config" model="ir.actions.act_window">
        <field name="name">Mobile Push Settings</field>
        <field name="res_model">nsp.notification.provider.config</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="nsp_notification_provider_config_default"/>
        <field name="target">current</field>
    </record>
</odoo>
