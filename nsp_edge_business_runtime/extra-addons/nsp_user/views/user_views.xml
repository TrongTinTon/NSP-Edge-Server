<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nsp_user_search" model="ir.ui.view">
        <field name="name">nsp.user.search</field>
        <field name="model">nsp.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="odoo_user_id" string="Login" groups="base.group_system"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="view_nsp_user_list" model="ir.ui.view">
        <field name="name">nsp.user.list</field>
        <field name="model">nsp.user</field>
        <field name="arch" type="xml">
            <list string="Users" create="0" decoration-muted="not active">
                <field name="image_128" string="" widget="image" class="o_avatar" optional="show"/>
                <field name="name" decoration-bf="1"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="odoo_user_id" string="Login" optional="hide" groups="base.group_system"/>
                <field name="active" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_user_form" model="ir.ui.view">
        <field name="name">nsp.user.form</field>
        <field name="model">nsp.user</field>
        <field name="arch" type="xml">
            <form string="User" create="0">
                <header>
                    <button name="action_archive" type="object" string="Archive" icon="fa-archive"
                            help="Archive user" invisible="not active" class="btn-secondary"/>
                    <button name="action_unarchive" type="object" string="Restore" icon="fa-undo"
                            help="Restore user" invisible="active" class="btn-primary"/>
                    <field name="active" invisible="1"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Friends" name="nsp_user_friends"
                              groups="nsp_core.group_nsp_it_parking,base.group_system">
                            <div class="o_horizontal_separator fw-bolder">
                                <i class="fa fa-users me-2"/>Friends
                            </div>
                            <field name="accepted_friendship_ids" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="name" string="Friend"/>
                                    <field name="accepted_at" string="Since" optional="show"/>
                                    <button name="action_cancel" type="object" string="Remove" icon="fa-user-times"
                                            help="Remove friend"/>
                                </list>
                            </field>

                            <div class="o_horizontal_separator fw-bolder mt-3">
                                <i class="fa fa-paper-plane me-2"/>Sent
                            </div>
                            <field name="friendship_sent_ids" nolabel="1"
                                   domain="[('state','=','pending')]"
                                   context="{'default_requester_id': id}">
                                <list editable="bottom">
                                    <field name="addressee_id" string="Friend" domain="[('id','!=',parent.id)]"/>
                                    <field name="state" string="Status" widget="badge" readonly="1"/>
                                    <button name="action_cancel" type="object" string="Cancel" icon="fa-times"
                                            help="Cancel request"/>
                                </list>
                            </field>

                            <div class="o_horizontal_separator fw-bolder mt-3">
                                <i class="fa fa-inbox me-2"/>Received
                            </div>
                            <field name="friendship_received_ids" nolabel="1"
                                   domain="[('state','=','pending')]">
                                <list create="0" delete="0">
                                    <field name="requester_id" string="From"/>
                                    <field name="state" string="Status" widget="badge" readonly="1"/>
                                    <button name="action_accept" type="object" string="Accept" icon="fa-check"
                                            help="Accept request" class="btn-primary"/>
                                    <button name="action_cancel" type="object" string="Decline" icon="fa-times"
                                            help="Decline request"/>
                                </list>
                            </field>
                        </page>

                        <page string="Settings" name="nsp_user_settings" groups="base.group_system">
                            <group>
                                <group string="System" name="nsp_user_system_settings">
                                    <field name="odoo_user_id" string="Login" readonly="1"
                                           options="{'no_create': True, 'no_open': True}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_nsp_user" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">nsp.user</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_user_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
