<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nsp_parking_log_search" model="ir.ui.view">
        <field name="name">view.nsp.parking.log.search</field>
        <field name="model">nsp.parking.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_time"/>
                <field name="parking_area_id"/>
                <field name="lane_id"/>
                <field name="vehicle_id"/>
                <field name="user_id"/>
                <field name="event_type"/>
                <field name="decision"/>
                <field name="reason_code"/>
                <filter string="Check-in" name="check_in" domain="[('event_type','=','check_in')]"/>
                <filter string="Check-out" name="check_out" domain="[('event_type','=','check_out')]"/>
                <filter string="Allowed" name="allowed" domain="[('decision','=','allowed')]"/>
                <filter string="Denied" name="denied" domain="[('decision','=','denied')]"/>
                <filter string="Missing User Tag" name="missing_user_tid" domain="[('reason_code','=','missing_user_tid')]"/>
                <filter string="Wrong Parking Area" name="vehicle_checked_in_other_area" domain="[('reason_code','=','vehicle_checked_in_other_area')]"/>
                <filter string="Authorization Denied" name="authorization_denied"
                        domain="[('reason_code','=','unauthorized_vehicle_user')]"/>
                <separator/>
                <filter string="Parking Area" name="group_parking_area" context="{'group_by':'parking_area_id'}"/>
                <filter string="Lane" name="group_lane" context="{'group_by':'lane_id'}"/>
                <filter string="Event" name="group_event_type" context="{'group_by':'event_type'}"/>
                <filter string="Decision" name="group_decision" context="{'group_by':'decision'}"/>
                <filter string="Reason" name="group_reason" context="{'group_by':'reason_code'}"/>
                <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_nsp_parking_log_list" model="ir.ui.view">
        <field name="name">view.nsp.parking.log.list</field>
        <field name="model">nsp.parking.log</field>
        <field name="arch" type="xml">
            <list string="Parking Logs" create="0" edit="0" delete="0">
                <field name="event_time"/>
                <field name="parking_area_id" string="Parking Area"/>
                <field name="lane_id" string="Lane"/>
                <field name="vehicle_display" string="Vehicle"/>
                <field name="user_id" string="User"/>
                <field name="event_type" string="Event" widget="badge"
                       decoration-success="event_type == 'check_in'"
                       decoration-info="event_type == 'check_out'"/>
                <field name="decision" widget="badge"
                       decoration-success="decision == 'allowed'"
                       decoration-danger="decision == 'denied'"/>
                <field name="reason_code" string="Reason" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_parking_log_form" model="ir.ui.view">
        <field name="name">view.nsp.parking.log.form</field>
        <field name="model">nsp.parking.log</field>
        <field name="arch" type="xml">
            <form string="Parking Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Parking Event">
                            <field name="event_time"/>
                            <field name="event_type" string="Event" widget="badge"/>
                            <field name="decision" widget="badge"/>
                            <field name="reason_code" string="Reason"/>
                        </group>
                        <group string="Context">
                            <field name="parking_area_id"/>
                            <field name="lane_id"/>
                            <field name="vehicle_display" string="Vehicle"/>
                            <field name="user_id" string="User"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_parking_log" model="ir.actions.act_window">
        <field name="name">Parking Logs</field>
        <field name="res_model">nsp.parking.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_parking_log_search"/>
    </record>
</odoo>
