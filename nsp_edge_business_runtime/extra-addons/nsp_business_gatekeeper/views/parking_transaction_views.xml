<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nsp_parking_transaction_search" model="ir.ui.view">
        <field name="name">view.nsp.parking.transaction.search</field>
        <field name="model">nsp.parking.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="transaction_uid"/>
                <field name="controller_id"/>
                <field name="controller_code"/>
                <field name="parking_area_id"/>
                <field name="parking_area_code"/>
                <field name="layout_revision"/>
                <field name="sequence_path"/>
                <field name="observed_duration_seconds"/>
                <field name="allowed_duration_seconds"/>
                <field name="lane_id"/>
                <field name="lane_code"/>
                <field name="reader_id"/>
                <field name="vehicle_id"/>
                <field name="vehicle_code"/>
                <field name="license_plate"/>
                <field name="vehicle_tid"/>
                <field name="user_id"/>
                <field name="user_code"/>
                <field name="user_tid"/>
                <field name="observed_user_tids"/>
                <field name="observed_user_codes"/>
                <field name="borrow_id"/>
                <field name="borrow_code"/>
                <field name="event_type"/>
                <field name="status"/>
                <field name="error_code"/>
                <filter string="Check-in" name="check_in" domain="[('event_type','=','check_in')]"/>
                <filter string="Check-out" name="check_out" domain="[('event_type','=','check_out')]"/>
                <filter string="Allowed" name="allowed" domain="[('status','=','allowed')]"/>
                <filter string="Denied" name="denied" domain="[('status','=','denied')]"/>
                <filter string="Missing User Tag" name="missing_user_tid" domain="[('error_code','=','missing_user_tid')]"/>
                <filter string="Multiple User Tags" name="multiple_user_tags" domain="[('error_code','=','multiple_user_tags')]"/>
                <filter string="Wrong Parking Area" name="vehicle_checked_in_other_area" domain="[('error_code','=','vehicle_checked_in_other_area')]"/>
                <filter string="Authentication Errors" name="auth_errors"
                        domain="[('error_code','in',['vehicle_not_found','user_tag_not_assigned','unauthorized_vehicle_user'])]"/>
                <separator/>
                <filter string="Controller" name="group_controller" context="{'group_by':'controller_id'}"/>
                <filter string="Lane" name="group_lane" context="{'group_by':'lane_id'}"/>
                <filter string="Event Type" name="group_event_type" context="{'group_by':'event_type'}"/>
                <filter string="Decision" name="group_status" context="{'group_by':'status'}"/>
                <filter string="Decision Reason" name="group_error_code" context="{'group_by':'error_code'}"/>
                <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_nsp_parking_transaction_list" model="ir.ui.view">
        <field name="name">view.nsp.parking.transaction.list</field>
        <field name="model">nsp.parking.transaction</field>
        <field name="arch" type="xml">
            <list string="Parking Transactions" create="0" edit="0" delete="0">
                <field name="event_time" string="Event Time"/>
                <field name="parking_area_display" string="Parking Area"/>
                <field name="lane_display" string="Lane"/>
                <field name="vehicle_display" string="Vehicle"/>
                <field name="user_id" optional="show"/>
                <field name="event_type" widget="badge"
                       decoration-success="event_type == 'check_in'"
                       decoration-info="event_type == 'check_out'"/>
                <field name="status" string="Decision" widget="badge"
                       decoration-success="status == 'allowed'"
                       decoration-danger="status == 'denied'"/>
                <field name="error_code" string="Reason" widget="badge" optional="show"/>
                <field name="layout_revision" optional="show"/>
                <field name="sequence_path" optional="hide"/>
                <field name="observed_duration_seconds" optional="hide"/>
                <field name="allowed_duration_seconds" optional="hide"/>
                <field name="detection_count" optional="show"/>
                <field name="controller_id" optional="hide"/>
                <field name="controller_code" optional="hide"/>
                <field name="parking_area_code" optional="hide"/>
                <field name="lane_code" optional="hide"/>
                <field name="reader_id" optional="hide"/>
                <field name="port_no" optional="hide"/>
                <field name="vehicle_code" optional="hide"/>
                <field name="vehicle_tid" optional="hide"/>
                <field name="user_code" optional="hide"/>
                <field name="user_tid" optional="hide"/>
                <field name="observed_user_tids" optional="hide"/>
                <field name="observed_user_codes" optional="hide"/>
                <field name="borrow_code" optional="hide"/>
                <field name="transaction_uid" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_parking_transaction_form" model="ir.ui.view">
        <field name="name">view.nsp.parking.transaction.form</field>
        <field name="model">nsp.parking.transaction</field>
        <field name="arch" type="xml">
            <form string="Parking Transaction" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Transaction">
                            <field name="transaction_uid"/>
                            <field name="event_time"/>
                            <field name="event_type" widget="badge"/>
                            <field name="status" string="Decision" widget="badge"/>
                            <field name="error_code" string="Decision Reason"/>
                            <field name="error_message" string="Decision Message"/>
                            <field name="detection_count"/>
                        </group>
                        <group string="Location and Reader Port">
                            <field name="controller_id"/>
                            <field name="controller_code"/>
                            <field name="parking_area_id"/>
                            <field name="parking_area_code"/>
                            <field name="layout_revision"/>
                            <field name="lane_id"/>
                            <field name="lane_code"/>
                            <field name="sequence_path"/>
                            <field name="observed_duration_seconds"/>
                            <field name="allowed_duration_seconds"/>
                            <field name="reader_id"/>
                            <field name="serial_number"/>
                            <field name="port_no"/>
                        </group>
                    </group>
                    <group>
                        <group string="Vehicle">
                            <field name="vehicle_id"/>
                            <field name="vehicle_code"/>
                            <field name="license_plate"/>
                            <field name="vehicle_tid"/>
                        </group>
                        <group string="User and Borrow">
                            <field name="user_id"/>
                            <field name="user_code"/>
                            <field name="user_tid"/>
                            <field name="observed_user_tids"/>
                            <field name="observed_user_codes"/>
                            <field name="borrow_id"/>
                            <field name="borrow_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Source Detections">
                            <field name="detection_event_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="detected_at"/>
                                    <field name="layout_revision"/>
                                    <field name="reader_id"/>
                                    <field name="port_no"/>
                                    <field name="tid"/>
                                    <field name="rssi_dbm" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_parking_transaction" model="ir.actions.act_window">
        <field name="name">Parking Transactions</field>
        <field name="res_model">nsp.parking.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_parking_transaction_search"/>
    </record>
</odoo>
