<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nsp_business_gatekeeper.DeviceTreeView">
        <div class="nsp-device-tree">
            <aside class="nsp-device-tree__tree-panel">
                <div class="nsp-device-tree__tree-scroll">
                    <t t-if="tree.length">
                        <t t-foreach="tree" t-as="server" t-key="server.key">
                            <div class="nsp-device-tree__node nsp-device-tree__node--server">
                                <div class="nsp-device-tree__row nsp-device-tree__row--group">
                                    <button type="button" class="nsp-device-tree__group-main" t-on-click="() => this.toggleExpanded(server.key)">
                                        <span class="nsp-device-tree__chevron"><i t-att-class="isExpanded(server.key) ? 'fa fa-chevron-down' : 'fa fa-chevron-right'"/></span>
                                        <span class="nsp-device-tree__icon"><i class="fa fa-server"/></span>
                                        <span class="nsp-device-tree__name" t-esc="server.name"/>
                                        <span t-att-class="'nsp-device-tree__dot is-' + server.status"/>
                                    </button>
                                </div>
                                <div t-if="isExpanded(server.key)" class="nsp-device-tree__children">
                                    <t t-foreach="server.controllers" t-as="controller" t-key="controller.key">
                                        <div class="nsp-device-tree__node nsp-device-tree__node--controller">
                                            <div class="nsp-device-tree__row nsp-device-tree__row--group">
                                                <button type="button" class="nsp-device-tree__group-main" t-on-click="() => this.toggleExpanded(controller.key)">
                                                    <span class="nsp-device-tree__chevron"><i t-att-class="isExpanded(controller.key) ? 'fa fa-chevron-down' : 'fa fa-chevron-right'"/></span>
                                                    <span class="nsp-device-tree__icon"><i class="fa fa-sitemap"/></span>
                                                    <span class="nsp-device-tree__name" t-esc="controller.name"/>
                                                    <span t-att-class="'nsp-device-tree__dot is-' + controller.status"/>
                                                </button>
                                            </div>
                                            <div t-if="isExpanded(controller.key)" class="nsp-device-tree__children">
                                                <t t-foreach="controller.readers" t-as="entry" t-key="entry.key">
                                                    <div t-att-class="'nsp-device-tree__row nsp-device-tree__row--reader ' + (selectedEntry &amp;&amp; selectedEntry.key === entry.key ? 'is-selected' : '')">
                                                        <button type="button" class="nsp-device-tree__reader-main" t-on-click="() => this.selectReader(entry)">
                                                            <span class="nsp-device-tree__chevron"/>
                                                            <span class="nsp-device-tree__icon"><i class="fa fa-microchip"/></span>
                                                            <span class="nsp-device-tree__reader-copy">
                                                                <span class="nsp-device-tree__name" t-esc="entry.reader.name"/>
                                                                <span class="nsp-device-tree__reader-status">
                                                                    <span t-att-class="'nsp-device-tree__dot is-' + entry.reader.status"/>
                                                                    <span t-esc="statusLabel(entry.reader.status)"/>
                                                                </span>
                                                            </span>
                                                        </button>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                    <div t-elif="!state.loaded" class="nsp-device-tree__empty">Loading Device Configuration...</div>
                    <div t-else="" class="nsp-device-tree__empty">
                        <i class="fa fa-sitemap"/>
                        <strong>No Device Tree mapping</strong>
                        <span>The released configuration has no complete Server → Controller → Reader hierarchy.</span>
                    </div>
                </div>
            </aside>

            <section class="nsp-device-tree__config-panel">
                <t t-if="selectedEntry">
                    <header class="nsp-device-tree__config-header">
                        <div class="nsp-device-tree__config-identity">
                            <span class="nsp-device-tree__reader-icon"><i class="fa fa-microchip"/></span>
                            <div>
                                <div class="nsp-device-tree__title-line">
                                    <h3 t-esc="selectedEntry.reader.name"/>
                                    <span t-att-class="'nsp-device-tree__operational is-' + selectedEntry.reader.status">
                                        <span t-att-class="'nsp-device-tree__dot is-' + selectedEntry.reader.status"/>
                                        <span t-esc="statusLabel(selectedEntry.reader.status)"/>
                                    </span>
                                </div>
                                <div class="nsp-device-tree__breadcrumb" t-esc="breadcrumb"/>
                            </div>
                        </div>
                    </header>

                    <div class="nsp-device-tree__config-scroll">
                        <div class="nsp-device-tree__section-head">
                            <div>
                                <div class="nsp-device-tree__section-title-line">
                                    <h4>Reader Information</h4>
                                    <span class="nsp-device-tree__mode-badge is-view">View mode</span>
                                </div>
                                <p>Published configuration synchronized from Cloud. Configuration and operational state are independent.</p>
                            </div>
                        </div>
                        <div class="nsp-device-tree__fields">
                            <div class="nsp-device-tree__field"><label>Reader Name</label><div class="nsp-device-tree__value" t-esc="selectedEntry.reader.name"/></div>
                            <div class="nsp-device-tree__field"><label>Serial</label><div class="nsp-device-tree__value" t-esc="selectedEntry.reader.serial"/></div>
                            <div class="nsp-device-tree__field"><label>Power</label><div class="nsp-device-tree__value"><t t-esc="selectedEntry.values.power"/> dBm</div></div>
                            <div class="nsp-device-tree__field"><label>Read Interval</label><div class="nsp-device-tree__value"><t t-esc="selectedEntry.values.interval"/> ms</div></div>
                            <div class="nsp-device-tree__field"><label>TID Start Address</label><div class="nsp-device-tree__value"><t t-esc="selectedEntry.values.tidStart"/> words</div></div>
                            <div class="nsp-device-tree__field"><label>TID Length</label><div class="nsp-device-tree__value"><t t-esc="selectedEntry.values.tidLength"/> words</div></div>
                            <div class="nsp-device-tree__field nsp-device-tree__field--full">
                                <label>Antennas</label>
                                <div class="nsp-device-tree__antenna-badges">
                                    <span t-foreach="selectedAntennaNumbers" t-as="portNo" t-key="portNo" class="nsp-lane-preview__antenna-badge">Antenna <t t-esc="portNo"/></span>
                                    <span t-if="!selectedAntennaNumbers.length" class="nsp-device-tree__value">—</span>
                                </div>
                            </div>
                        </div>
                        <div class="nsp-device-tree__meta">
                            <span>Configuration <strong>Synchronized</strong></span>
                            <span>Operational <strong t-esc="statusLabel(selectedEntry.reader.status)"/></span>
                        </div>
                    </div>
                </t>
                <div t-else="" class="nsp-device-tree__config-empty"><i class="fa fa-microchip"/><h3>Reader Configuration</h3><p>Select a Reader from the NSP Tree View.</p></div>
            </section>
        </div>
    </t>
</templates>
