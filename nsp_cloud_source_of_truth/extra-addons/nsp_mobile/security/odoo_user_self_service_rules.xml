<odoo>
    <!--
        Self-service uses the authenticated standard res.users environment.
        No separate NSP access flag or custom login permission is maintained.
        Standard internal Odoo Users receive only their own NSP business scope;
        existing NSP operator/HR/IT groups retain their original wider scope.
    -->

    <!-- NSP User: discover active Odoo-linked users, but edit only the linked self record. -->
    <record id="rule_nsp_user_self_service_read" model="ir.rule">
        <field name="name">NSP User: Odoo User self-service read</field>
        <field name="model_id" ref="nsp_user.model_nsp_user"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_nsp_user_self_service_write" model="ir.rule">
        <field name="name">NSP User: Odoo User self-service write own</field>
        <field name="model_id" ref="nsp_user.model_nsp_user"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('odoo_user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Friend records are visible and mutable only when the current Odoo User is one endpoint. -->
    <record id="rule_nsp_user_friendship_self_service" model="ir.rule">
        <field name="name">NSP Friendship: Odoo User self-service</field>
        <field name="model_id" ref="nsp_user.model_nsp_user_friendship"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('requester_id.odoo_user_id', '=', user.id), ('addressee_id.odoo_user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Vehicles are readable by the owner and by users who have a borrow history for that vehicle. -->
    <record id="rule_nsp_vehicle_self_service_read" model="ir.rule">
        <field name="name">NSP Vehicle: Odoo User self-service read</field>
        <field name="model_id" ref="nsp_vehicle.model_nsp_vehicle"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('owner_id.odoo_user_id', '=', user.id), ('borrow_ids.borrower_id.odoo_user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Borrow history is visible to owner or borrower; only the owner can create/change it. -->
    <record id="rule_nsp_vehicle_borrow_self_service_read" model="ir.rule">
        <field name="name">NSP Vehicle Borrow: Odoo User self-service read</field>
        <field name="model_id" ref="nsp_vehicle.model_nsp_vehicle_borrow"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('vehicle_id.owner_id.odoo_user_id', '=', user.id), ('borrower_id.odoo_user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_nsp_vehicle_borrow_self_service_manage" model="ir.rule">
