        <field name="name">NSP Mobile</field>
        <field name="application_kind">mobile</field>
        <field name="domain_id" ref="t4_coreapi.core_api_domain_default"/>
        <field name="state">active</field>
        <field name="token_ttl_hours">1</field>
        <field name="refresh_token_ttl_days">30</field>
        <field name="rate_limit_per_minute">180</field>
        <field name="notes">System Mobile Application. Mobile login authenticates an internal Odoo User and requires exactly one pre-linked active NSP User business profile. Login never creates or relinks the business identity. Tokens remain bound to res.users, the Mobile session and the current device.</field>
