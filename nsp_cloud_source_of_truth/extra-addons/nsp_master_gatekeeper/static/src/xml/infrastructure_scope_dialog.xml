<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nsp_master_gatekeeper.InfrastructureScopeDialog">
        <Dialog title="'Infrastructure Scope'" size="'xl'" contentClass="'nsp-infra-dialog'">
            <div class="nsp-infra">
                <div class="nsp-infra__subheader">
                    <div>
                        <span>Lane Calibration:</span>
                        <strong t-esc="state.data.measurement_code || '—'"/>
                        <span class="nsp-infra__revision">R<t t-esc="state.data.revision || 1"/></span>
                    </div>
                    <div class="nsp-infra__subheader-actions">
                        <span class="nsp-infra__last-refresh">
                            <i class="fa fa-clock-o me-1"/>
                            Last refresh: <t t-esc="formatDateTime(state.data.server_time)"/>
                        </span>
                        <button type="button" class="btn btn-outline-primary" t-on-click="refresh">
                            <i class="fa fa-refresh me-1"/>Refresh
                        </button>
                        <button t-if="state.data.editable" type="button" class="btn btn-primary"
                                t-on-click="() => this.openReader(0)">
                            <i class="fa fa-plus me-1"/>New
                        </button>
                    </div>
                </div>

                <div t-if="state.error" class="alert alert-danger" t-esc="state.error"/>

                <div class="nsp-infra__summary">
                    <article t-att-class="'nsp-infra-summary nsp-infra-summary--' + summaryStatus(state.data.summary.edge_online || 0, state.data.summary.edge_total || 0)">
                        <div class="nsp-infra-summary__icon"><i class="fa fa-server"/></div>
                        <div class="nsp-infra-summary__body">
                            <span>Edge Server<t t-if="(state.data.summary.edge_total || 0) !== 1">s</t></span>
                            <strong t-esc="summaryText(state.data.summary.edge_online || 0, state.data.summary.edge_total || 0)"/>
                            <small t-if="(state.data.edges || []).length">
                                Last heartbeat: <t t-esc="formatRelative(state.data.edges[0].last_heartbeat)"/>
                            </small>
                            <small t-else="">No Edge Server in scope</small>
                        </div>
                        <i t-att-class="'fa ' + ((state.data.summary.edge_online || 0) === (state.data.summary.edge_total || 0) &amp;&amp; (state.data.summary.edge_total || 0) ? 'fa-check-circle' : 'fa-exclamation-circle')"/>
                    </article>

                    <article t-att-class="'nsp-infra-summary nsp-infra-summary--' + summaryStatus(state.data.summary.controller_online || 0, state.data.summary.controller_total || 0)">
                        <div class="nsp-infra-summary__icon"><i class="fa fa-sitemap"/></div>
                        <div class="nsp-infra-summary__body">
                            <span>Controller<t t-if="(state.data.summary.controller_total || 0) !== 1">s</t></span>
                            <strong t-esc="summaryText(state.data.summary.controller_online || 0, state.data.summary.controller_total || 0)"/>
                            <small>Runtime: <t t-esc="state.data.runtime_active ? 'Lane Calibration' : 'Inactive'"/></small>
                        </div>
                        <i t-att-class="'fa ' + ((state.data.summary.controller_online || 0) === (state.data.summary.controller_total || 0) &amp;&amp; (state.data.summary.controller_total || 0) ? 'fa-check-circle' : 'fa-exclamation-circle')"/>
                    </article>

                    <article t-att-class="'nsp-infra-summary nsp-infra-summary--' + summaryStatus(state.data.summary.reader_connected || 0, state.data.summary.reader_total || 0)">
                        <div class="nsp-infra-summary__icon"><i class="fa fa-wifi"/></div>
                        <div class="nsp-infra-summary__body">
                            <span>Readers</span>
                            <strong t-esc="readerSummaryText()"/>
                            <small class="nsp-infra-summary__stats">
                                <span class="nsp-dot nsp-dot--success"/><t t-esc="state.data.summary.reader_active || 0"/> Active
                                <span class="nsp-dot nsp-dot--warning"/><t t-esc="state.data.summary.reader_silent || 0"/> Silent
                                <span class="nsp-dot nsp-dot--danger"/><t t-esc="state.data.summary.reader_offline || 0"/> Offline
                            </small>
                        </div>
                        <i t-att-class="'fa ' + ((state.data.summary.reader_connected || 0) === (state.data.summary.reader_total || 0) &amp;&amp; (state.data.summary.reader_total || 0) ? 'fa-check-circle' : 'fa-exclamation-circle')"/>
                    </article>
                </div>

                <nav class="nsp-infra__tabs">
                    <button type="button" t-att-class="state.tab === 'live' ? 'active' : ''"
                            t-on-click="() => this.setTab('live')">
                        <i class="fa fa-line-chart me-1"/>Live Status
                    </button>
                    <button type="button" t-att-class="state.tab === 'config' ? 'active' : ''"
                            t-on-click="() => this.setTab('config')">
                        <i class="fa fa-cog me-1"/>Scope Configuration
                    </button>
                </nav>

                <div t-if="state.tab === 'live'" class="nsp-infra__live-grid">
                    <section class="nsp-infra__topology">
                        <div t-if="!(state.data.edges || []).length" class="nsp-infra__empty">
                            <i class="fa fa-sitemap"/>
                            <strong>No Infrastructure Scope configured</strong>
                            <span>Add an Edge Server, Controller, Reader and Reader Ports before releasing this Lane Calibration.</span>
                        </div>

                        <div t-foreach="state.data.edges || []" t-as="edge" t-key="edge.id" class="nsp-infra-node nsp-infra-node--edge">
                            <div class="nsp-infra-node__row">
                                <button type="button" class="nsp-infra-node__toggle"
                                        t-on-click="() => this.toggleExpanded('expandedEdges', edge.id)">
                                    <i t-att-class="'fa ' + (isExpanded('expandedEdges', edge.id) ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                </button>
                                <div class="nsp-infra-node__icon"><i class="fa fa-server"/></div>
                                <div class="nsp-infra-node__main">
                                    <strong>Edge Server: <span t-esc="edge.code || edge.name"/></strong>
                                    <small><t t-esc="edge.name"/> · Last heartbeat: <t t-esc="formatRelative(edge.last_heartbeat)"/></small>
                                </div>
                                <span t-att-class="'nsp-infra-status nsp-infra-status--' + statusTone(edge.status)"
                                      t-esc="statusLabel(edge.status)"/>
                            </div>

                            <div t-if="isExpanded('expandedEdges', edge.id)" class="nsp-infra-node__children">
                                <div t-foreach="edge.controllers || []" t-as="controller" t-key="controller.id"
                                     class="nsp-infra-node nsp-infra-node--controller">
                                    <div class="nsp-infra-node__row">
                                        <button type="button" class="nsp-infra-node__toggle"
                                                t-on-click="() => this.toggleExpanded('expandedControllers', controller.id)">
                                            <i t-att-class="'fa ' + (isExpanded('expandedControllers', controller.id) ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                        </button>
                                        <div class="nsp-infra-node__icon"><i class="fa fa-sitemap"/></div>
                                        <div class="nsp-infra-node__main">
                                            <strong>Controller: <span t-esc="controller.code || controller.name"/></strong>
                                            <small><t t-esc="controller.name"/> · Runtime: <t t-esc="controller.runtime_mode"/> · Last heartbeat: <t t-esc="formatRelative(controller.last_heartbeat)"/></small>
                                        </div>
                                        <span t-att-class="'nsp-infra-status nsp-infra-status--' + statusTone(controller.status)"
                                              t-esc="statusLabel(controller.status)"/>
                                    </div>

                                    <div t-if="isExpanded('expandedControllers', controller.id)" class="nsp-infra-node__children">
                                        <div t-foreach="controller.readers || []" t-as="reader" t-key="reader.reader_line_id"
                                             t-att-class="'nsp-infra-node nsp-infra-node--reader ' + (isReaderSelected(reader) ? 'is-selected' : '')">
                                            <div class="nsp-infra-node__row" t-on-click="() => this.selectReader(reader)">
                                                <button type="button" class="nsp-infra-node__toggle"
                                                        t-on-click.stop="() => this.toggleExpanded('expandedReaders', reader.reader_line_id)">
                                                    <i t-att-class="'fa ' + (isExpanded('expandedReaders', reader.reader_line_id) ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                                </button>
                                                <div class="nsp-infra-node__icon"><i class="fa fa-wifi"/></div>
                                                <div class="nsp-infra-node__main">
                                                    <strong>Reader: <span t-esc="reader.name"/></strong>
                                                    <small>Serial: <t t-esc="reader.serial_number || '—'"/> · Connection: <t t-esc="reader.connection_label || '—'"/></small>
                                                    <small>Last seen: <t t-esc="formatRelative(reader.last_seen)"/> · Last detection: <t t-esc="formatRelative(reader.last_detection)"/></small>
                                                    <small t-att-class="'nsp-infra-node__activity nsp-infra-node__activity--' + activityTone(reader.activity_status)">
                                                        <i class="fa fa-signal me-1"/>Read activity: <t t-esc="activityLabel(reader.activity_status)"/>
                                                    </small>
                                                </div>
                                                <span t-att-class="'nsp-infra-status nsp-infra-status--' + activityTone(reader.activity_status)"
                                                      t-esc="activityLabel(reader.activity_status)"/>
                                            </div>

                                            <div t-if="isExpanded('expandedReaders', reader.reader_line_id)" class="nsp-infra-ports">
                                                <div t-if="!(reader.ports || []).length" class="nsp-infra-ports__empty">No Reader Ports configured.</div>
                                                <div t-foreach="reader.ports || []" t-as="port" t-key="port.port_no" class="nsp-infra-port">
                                                    <span t-att-class="'nsp-dot nsp-dot--' + activityTone(port.activity)"/>
                                                    <strong>Port <t t-esc="port.port_no"/></strong>
                                                    <span t-esc="port.configured ? 'Configured' : 'Outside scope'"/>
                                                    <em t-att-class="'nsp-infra-port__activity nsp-infra-port__activity--' + activityTone(port.activity)"
                                                        t-esc="portActivityLabel(port)"/>
                                                    <small t-esc="formatRelative(port.last_detection)"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <aside class="nsp-infra__details">
                        <t t-set="reader" t-value="selectedReader()"/>
                        <t t-if="reader">
                            <div class="nsp-infra__details-heading">
                                <h3>Reader Details</h3>
                                <button t-if="state.data.editable" type="button" class="btn btn-sm btn-outline-secondary"
                                        t-on-click="() => this.openReader(reader.reader_line_id)">
                                    <i class="fa fa-pencil me-1"/>Edit
                                </button>
                            </div>
                            <dl class="nsp-infra-details-list">
                                <dt>Reader Name</dt><dd t-esc="reader.name || '—'"/>
                                <dt>SDK Serial Number</dt><dd t-esc="reader.detected_serial_number || reader.serial_number || '—'"/>
                                <dt>Connection</dt>
                                <dd><span t-att-class="'nsp-dot nsp-dot--' + statusTone(reader.status)"/><t t-esc="statusLabel(reader.status)"/></dd>
                                <dt>Physical Connection</dt><dd t-esc="reader.connection_label || '—'"/>
                                <dt>Last Seen</dt><dd t-esc="formatRelative(reader.last_seen)"/>
                                <dt>Last Detection</dt><dd t-esc="formatRelative(reader.last_detection)"/>
                                <dt>Read Activity</dt>
                                <dd><span t-att-class="'nsp-infra-status nsp-infra-status--' + activityTone(reader.activity_status)" t-esc="activityLabel(reader.activity_status)"/></dd>
                                <dt>Runtime Power</dt><dd><t t-esc="reader.runtime_power_dbm || reader.configured_power_dbm || 0"/> dBm</dd>
                                <dt>Read Interval</dt><dd><t t-esc="reader.runtime_read_interval_ms || reader.configured_read_interval_ms || 0"/> ms</dd>
                                <dt>Firmware</dt><dd t-esc="reader.firmware_version || 'Unknown'"/>
                                <dt>Last Error</dt><dd>—</dd>
                                <dt>Detections</dt><dd t-esc="reader.detection_count || 0"/>
                            </dl>

                            <div class="nsp-infra-legend">
                                <h4>Status Legend</h4>
                                <div><span class="nsp-dot nsp-dot--success"/><strong>Active</strong><small>Reader is connected and producing detections</small></div>
                                <div><span class="nsp-dot nsp-dot--warning"/><strong>Silent</strong><small>Reader is connected but has no recent detections</small></div>
                                <div><span class="nsp-dot nsp-dot--danger"/><strong>Offline</strong><small>Reader is not connected</small></div>
                                <div><span class="nsp-dot nsp-dot--muted"/><strong>Unknown</strong><small>No runtime data is available</small></div>
                            </div>
                        </t>
                        <div t-else="" class="nsp-infra__empty nsp-infra__empty--details">
                            <i class="fa fa-wifi"/>
                            <strong>Select a Reader</strong>
                            <span>Reader status and runtime parameters will appear here.</span>
                        </div>
                    </aside>
                </div>

                <section t-if="state.tab === 'config'" class="nsp-infra__configuration">
                    <div class="nsp-infra__configuration-heading">
                        <div>
                            <h3>Scope Configuration</h3>
                            <p>Define the Server, Controller, RFID Reader and Reader Ports used by this calibration.</p>
                        </div>
                        <button t-if="state.data.editable" type="button" class="btn btn-primary"
                                t-on-click="() => this.openReader(0)">
                            <i class="fa fa-plus me-1"/>New Reader Assembly
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table nsp-infra-config-table">
                            <thead>
                                <tr>
                                    <th>Edge Server</th>
                                    <th>Controller</th>
                                    <th>Reader</th>
                                    <th>Serial</th>
                                    <th>Ports</th>
                                    <th>Power</th>
                                    <th>Interval</th>
                                    <th>State</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.edges || []" t-as="edge" t-key="edge.id">
                                    <t t-foreach="edge.controllers || []" t-as="controller" t-key="controller.id">
                                        <tr t-foreach="controller.readers || []" t-as="reader" t-key="reader.reader_line_id">
                                            <td><strong t-esc="edge.code || edge.name"/><small t-esc="edge.name"/></td>
                                            <td><strong t-esc="controller.code || controller.name"/><small t-esc="controller.name"/></td>
                                            <td><strong t-esc="reader.name"/></td>
                                            <td t-esc="reader.serial_number || '—'"/>
                                            <td><span class="nsp-infra-config-table__ports" t-esc="configuredPortsLabel(reader)"/></td>
                                            <td><t t-esc="reader.configured_power_dbm || 0"/> dBm</td>
                                            <td><t t-esc="reader.configured_read_interval_ms || 0"/> ms</td>
                                            <td><span t-att-class="'nsp-infra-status nsp-infra-status--' + activityTone(reader.activity_status)" t-esc="activityLabel(reader.activity_status)"/></td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                                        t-on-click="() => this.openReader(reader.reader_line_id)">
                                                    <i t-att-class="'fa ' + (state.data.editable ? 'fa-pencil' : 'fa-eye')"/>
                                                </button>
                                                <button t-if="state.data.editable" type="button" class="btn btn-sm btn-outline-danger"
                                                        t-on-click="() => this.removeReader(reader)">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <tr t-if="!(state.data.readers || []).length">
                                    <td colspan="9" class="text-center text-muted py-5">No Reader Assembly configured.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <section t-if="(state.data.warnings || []).length" class="nsp-infra__warnings">
                    <div class="nsp-infra__warnings-title">
                        <i class="fa fa-exclamation-triangle"/>Warnings (<t t-esc="state.data.warnings.length"/>)
                    </div>
                    <div t-foreach="state.data.warnings || []" t-as="warning" t-key="warning.code + '-' + warning.message"
                         t-att-class="'nsp-infra-warning nsp-infra-warning--' + warning.severity">
                        <i t-att-class="'fa ' + warningIcon(warning.severity)"/>
                        <span t-esc="warning.message"/>
                        <time t-esc="formatDateTime(warning.happened_at)"/>
                    </div>
                </section>
            </div>

            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="() => props.close()">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
