<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nsp_master_gatekeeper.CalibrationWorkspace">
        <div class="nsp-lc">
            <div t-if="state.error" class="alert alert-danger" t-esc="state.error"/>

            <div class="nsp-lc__heading">
                <div>
                    <h2>Lane Calibration</h2>
                    <p>Observe once, select the required detection points, and apply them directly to a Lane.</p>
                </div>
                <span t-att-class="statusClass(state.data.status)" t-esc="statusLabel(state.data.status)"/>
            </div>

            <div class="nsp-lc__cards">
                <button type="button" class="nsp-lc-card" t-on-click="() => this.openCard('vehicles')">
                    <div class="nsp-lc-card__icon"><i class="fa fa-car"/></div>
                    <div class="nsp-lc-card__body">
                        <span>Vehicles</span>
                        <strong t-esc="state.data.vehicle_count || 0"/>
                        <small><t t-esc="state.data.vehicle_tag_count || 0"/> RFID Tags configured</small>
                    </div>
                    <i class="fa fa-external-link nsp-lc-card__open"/>
                </button>

                <button type="button" class="nsp-lc-card" t-on-click="() => this.openCard('coverage')">
                    <div class="nsp-lc-card__icon"><i class="fa fa-signal"/></div>
                    <div class="nsp-lc-card__body">
                        <span>RFID Coverage</span>
                        <strong><t t-esc="formatNumber(state.data.coverage_percent, 1)"/>%</strong>
                        <small><t t-esc="state.data.detected_vehicle_count || 0"/> / <t t-esc="state.data.vehicle_count || 0"/> Vehicles detected</small>
                    </div>
                    <i class="fa fa-external-link nsp-lc-card__open"/>
                </button>

                <button type="button" class="nsp-lc-card" t-on-click="() => this.openCard('infrastructure')">
                    <div class="nsp-lc-card__icon"><i class="fa fa-sitemap"/></div>
                    <div class="nsp-lc-card__body">
                        <span>Infrastructure Scope</span>
                        <strong><t t-esc="state.data.reader_online_count || 0"/> / <t t-esc="state.data.reader_count || 0"/></strong>
                        <small><t t-esc="state.data.reader_online_count || 0"/> Connected · <t t-esc="state.data.reader_offline_count || 0"/> Offline · <t t-esc="state.data.configured_reader_port_count || 0"/> Ports</small>
                    </div>
                    <i class="fa fa-external-link nsp-lc-card__open"/>
                </button>
            </div>

            <section class="nsp-lc__timeline">
                <div class="nsp-lc__toolbar">
                    <div>
                        <h3>Detection Timeline</h3>
                        <p>Select rows in the intended Check-in order. Check-out will be generated in reverse.</p>
                    </div>
                    <div class="nsp-lc__actions">
                        <span class="nsp-lc__selected"><t t-esc="state.selectedStepIds.length"/> selected</span>
                        <button type="button" class="btn btn-outline-danger"
                                t-att-disabled="!(state.data.raw_event_count &gt; 0)"
                                t-on-click="clearTimeline">
                            <i class="fa fa-trash me-1"/>Clear
                        </button>
                        <button type="button" class="btn btn-primary"
                                t-att-disabled="!canApply()"
                                t-on-click="applyConfiguration">
                            <i class="fa fa-check-square-o me-1"/>Apply Configuration
                        </button>
                    </div>
                </div>

                <div t-if="state.data.status === 'draft'" class="nsp-lc__notice">
                    Configure Vehicles and Infrastructure Scope from the cards above, then Release the calibration.
                </div>

                <div class="nsp-lc__table-wrap" t-if="(state.data.steps || []).length">
                    <table class="table nsp-lc__table">
                        <thead>
                            <tr>
                                <th class="nsp-lc__check"></th>
                                <th>Selected</th>
                                <th>Timeline</th>
                                <th>Detected</th>
                                <th>Vehicle</th>
                                <th>Controller</th>
                                <th>Reader</th>
                                <th>Port</th>
                                <th>Interval</th>
                                <th>Reads</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.data.steps || []" t-as="step" t-key="step.first_event_id"
                                t-att-class="isSelected(step) ? 'nsp-lc__row--selected' : ''">
                                <td class="nsp-lc__check">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="isSelected(step)"
                                           t-on-change="(ev) => this.toggleStep(step, ev)"/>
                                </td>
                                <td>
                                    <span t-if="selectionOrder(step)" class="nsp-lc__selection-order"
                                          t-esc="selectionOrder(step)"/>
                                    <span t-else="" class="text-muted">—</span>
                                </td>
                                <td><span class="nsp-lc__timeline-order" t-esc="step.sequence_no"/></td>
                                <td t-esc="formatDateTime(step.first_seen_at)"/>
                                <td>
                                    <strong t-esc="step.license_plate || step.assigned_to || '—'"/>
                                    <small class="nsp-lc__tid" t-esc="step.tid"/>
                                </td>
                                <td t-esc="step.controller_code || '—'"/>
                                <td>
                                    <strong t-esc="step.reader_name || step.serial_number"/>
                                    <small class="nsp-lc__tid" t-esc="step.serial_number"/>
                                </td>
                                <td><span class="nsp-lc__port">P<t t-esc="step.port_no"/></span></td>
                                <td><t t-esc="formatNumber(step.duration_from_previous, 3)"/> s</td>
                                <td t-esc="step.read_count"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div t-else="" class="nsp-lc__empty">
                    <i class="fa fa-rss"/>
                    <strong>No detections yet</strong>
                    <span>RFID detections will appear here while the Lane Calibration runtime is active.</span>
                </div>
            </section>
        </div>
    </t>
</templates>
