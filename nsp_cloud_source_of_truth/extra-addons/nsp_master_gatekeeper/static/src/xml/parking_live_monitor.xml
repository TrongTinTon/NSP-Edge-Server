<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nsp_master_gatekeeper.ParkingLiveMonitor">
        <div t-att-class="rootClass">
            <header class="nsp-parking-live-monitor__header">
                <div class="nsp-parking-live-monitor__identity min-w-0">
                    <div class="nsp-parking-live-monitor__settings-anchor">
                        <button type="button"
                                class="nsp-parking-live-monitor__identity-icon"
                                title="Cài đặt hiển thị"
                                aria-label="Cài đặt số cột hiển thị"
                                t-on-click="toggleSettings">
                            <img src="/nsp_master_gatekeeper/static/src/img/icons/live_monitor.svg" alt=""/>
                            <span class="nsp-parking-live-monitor__settings-mark" aria-hidden="true">
                                <i class="fa fa-cog"/>
                            </span>
                        </button>
                        <div class="nsp-parking-live-monitor__settings-popover" t-if="state.settingsOpen">
                            <div class="nsp-parking-live-monitor__settings-title">Bố cục Check-in</div>
                            <div class="nsp-parking-live-monitor__settings-help">Số cột phương tiện · 4 hàng cố định</div>
                            <div class="nsp-parking-live-monitor__settings-columns">
                                <t t-foreach="[8, 16, 24]" t-as="column" t-key="column">
                                    <button type="button"
                                            t-att-class="'nsp-parking-live-monitor__settings-column' + (displayColumns === column ? ' is-active' : '')"
                                            t-on-click="() => this.selectDisplayColumns(column)">
                                        <strong><t t-esc="column"/></strong>
                                        <span>cột · 4 hàng</span>
                                    </button>
                                </t>
                            </div>
                            <div class="nsp-parking-live-monitor__settings-help is-checkout-note">
                                Check-out dùng bố cục 4 × 4 để đủ chỗ đối chiếu người lấy xe.
                            </div>
                        </div>
                    </div>

                    <div class="nsp-parking-live-monitor__identity-copy min-w-0">
                        <div class="nsp-parking-live-monitor__eyebrow">LIVE MONITOR</div>
                        <div class="nsp-parking-live-monitor__title text-truncate">
                            <t t-esc="state.parkingAreaName || 'Bãi xe'"/>
                        </div>
                        <div class="nsp-parking-live-monitor__subtitle text-truncate">
                            <span t-if="state.branchName"><t t-esc="state.branchName"/></span>
                            <span class="nsp-parking-live-monitor__subtitle-separator" t-if="state.branchName and state.areaState">•</span>
                            <span class="nsp-parking-live-monitor__area-status" t-if="state.areaState">
                                <span class="nsp-parking-live-monitor__live-dot"/>
                                <t t-esc="areaStateLabel"/>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="nsp-parking-live-monitor__header-meta">
                    <div t-att-class="'nsp-parking-live-monitor__traffic-pill' + (isBurstMode ? ' is-burst' : '')">
                        <i class="fa fa-bolt"/>
                        <span><t t-esc="burstLabel"/></span>
                    </div>
                    <div class="nsp-parking-live-monitor__clock is-header-clock">
                        <i class="fa fa-clock-o"/>
                        <span><t t-esc="state.clock"/></span>
                    </div>
                </div>
            </header>

            <main class="nsp-parking-live-monitor__content">
                <!-- Check-in intentionally has no alert surface. Denied Check-in logs are ignored. -->
                <section class="nsp-parking-live-monitor__grid" t-if="isCheckInMode" t-att-style="gridStyle">
                    <t t-foreach="visibleEntries" t-as="row" t-key="row.key">
                        <article class="nsp-parking-live-monitor__entry-card" t-att-class="row.classes">
                            <div class="nsp-parking-live-monitor__plate" title="Biển số xe">
                                <t t-esc="row.item.license_plate || '-'"/>
                            </div>
                        </article>
                    </t>

                    <div class="nsp-parking-live-monitor__empty-state" t-if="!visibleEntries.length">
                        <span class="nsp-parking-live-monitor__empty-icon"><i class="fa fa-car"/></span>
                        <strong>Chưa có xe vào</strong>
                        <span>Xe Check-in mới sẽ xuất hiện tự động tại đây.</span>
                    </div>
                </section>

                <section class="nsp-parking-live-monitor__checkout-layout" t-if="isCheckOutMode">
                    <div class="nsp-parking-live-monitor__checkout-list-panel">
                        <div class="nsp-parking-live-monitor__panel-heading">
                            <div>
                                <span class="nsp-parking-live-monitor__panel-kicker">CHECK-OUT</span>
                                <strong>XE RA</strong>
                            </div>
                            <span><t t-esc="visibleEntries.length"/> / <t t-esc="visibleCapacity"/> lượt gần nhất</span>
                        </div>

                        <div class="nsp-parking-live-monitor__checkout-grid">
                            <t t-foreach="visibleEntries" t-as="row" t-key="row.key">
                                <article class="nsp-parking-live-monitor__checkout-card" t-att-class="row.classes">
                                    <div class="nsp-parking-live-monitor__checkout-avatar">
                                        <img t-if="row.item.avatar_url" t-att-src="row.item.avatar_url" alt=""/>
                                        <i t-else="" class="fa fa-user"/>
                                    </div>
                                    <div class="nsp-parking-live-monitor__checkout-card-copy min-w-0">
                                        <div class="nsp-parking-live-monitor__checkout-plate text-truncate">
                                            <t t-esc="row.item.license_plate || '-'"/>
                                        </div>
                                        <div class="nsp-parking-live-monitor__checkout-user text-truncate">
                                            <t t-esc="row.item.employee_name || 'CHƯA XÁC ĐỊNH NGƯỜI LẤY XE'"/>
                                        </div>
                                    </div>
                                </article>
                            </t>

                            <div class="nsp-parking-live-monitor__empty-state is-checkout" t-if="!visibleEntries.length">
                                <span class="nsp-parking-live-monitor__empty-icon"><i class="fa fa-sign-out"/></span>
                                <strong>Chưa có xe ra</strong>
                                <span>Check-out hợp lệ sẽ xuất hiện tại đây.</span>
                            </div>
                        </div>
                    </div>

                    <aside class="nsp-parking-live-monitor__guard-alert-panel">
                        <div class="nsp-parking-live-monitor__guard-alert-heading">
                            <span><i class="fa fa-shield me-2"/>CẢNH BÁO CHECK-OUT</span>
                            <strong t-if="state.alerts.length"><t t-esc="state.alerts.length"/></strong>
                        </div>

                        <div class="nsp-parking-live-monitor__guard-safe" t-if="!visibleAlerts.length">
                            <span class="nsp-parking-live-monitor__guard-safe-icon"><i class="fa fa-check"/></span>
                            <strong>KHÔNG CÓ CẢNH BÁO</strong>
                            <span>Chỉ lỗi Check-out mới hiển thị tại khu vực này.</span>
                        </div>

                        <div class="nsp-parking-live-monitor__guard-alerts" t-if="visibleAlerts.length">
                            <t t-foreach="visibleAlerts" t-as="alert" t-key="alert.log_uid || alert.id">
                                <article class="nsp-parking-live-monitor__guard-alert-card">
                                    <div class="nsp-parking-live-monitor__guard-alert-top">
                                        <span class="nsp-parking-live-monitor__guard-alert-icon"><i class="fa fa-exclamation-triangle"/></span>
                                        <span>KHÔNG CHO XE RA</span>
                                    </div>
                                    <div class="nsp-parking-live-monitor__guard-alert-plate">
                                        <t t-esc="alert.license_plate || '-'"/>
                                    </div>
                                    <div class="nsp-parking-live-monitor__guard-person">
                                        <div class="nsp-parking-live-monitor__guard-avatar">
                                            <img t-if="alert.avatar_url" t-att-src="alert.avatar_url" alt=""/>
                                            <i t-else="" class="fa fa-user"/>
                                        </div>
                                        <div class="min-w-0">
                                            <small>NGƯỜI ĐANG LẤY XE</small>
                                            <strong class="text-truncate">
                                                <t t-esc="alert.employee_name || 'CHƯA XÁC ĐỊNH'"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="nsp-parking-live-monitor__guard-alert-title">
                                        <t t-esc="alert.display_title || 'KHÔNG ĐƯỢC PHÉP LẤY XE'"/>
                                    </div>
                                    <div class="nsp-parking-live-monitor__guard-alert-reason">
                                        <t t-esc="alert.display_reason || 'Vui lòng kiểm tra trước khi cho xe ra'"/>
                                    </div>
                                    <div class="nsp-parking-live-monitor__guard-alert-lane" t-if="alert.lane_name">
                                        <i class="fa fa-map-marker me-1"/><t t-esc="alert.lane_name"/>
                                    </div>
                                </article>
                            </t>
                        </div>
                        <div class="nsp-parking-live-monitor__guard-alert-more" t-if="hiddenAlertCount">
                            +<t t-esc="hiddenAlertCount"/> cảnh báo khác
                        </div>
                    </aside>
                </section>
            </main>

            <footer class="nsp-parking-live-monitor__footer">
                <div class="nsp-parking-live-monitor__mode-switch" role="group" aria-label="Chế độ Live Monitor">
                    <button type="button"
                            t-att-class="'nsp-parking-live-monitor__mode-button' + (isCheckInMode ? ' is-active' : '')"
                            t-on-click="() => this.selectDisplayMode('check_in')">
                        <i class="fa fa-sign-in"/> CHECK-IN
                    </button>
                    <button type="button"
                            t-att-class="'nsp-parking-live-monitor__mode-button' + (isCheckOutMode ? ' is-active is-checkout' : '')"
                            t-on-click="() => this.selectDisplayMode('check_out')">
                        <i class="fa fa-sign-out"/> CHECK-OUT
                    </button>
                </div>
                <div class="nsp-parking-live-monitor__flow-info">
                    <span class="nsp-parking-live-monitor__footer-dot"/>
                    <strong><t t-esc="queueLabel"/></strong>
                    <span t-if="isCheckOutMode and state.alerts.length"> · <t t-esc="state.alerts.length"/> cảnh báo</span>
                </div>
            </footer>

            <div class="nsp-parking-live-monitor__error" t-if="state.error">
                <i class="fa fa-exclamation-triangle me-2"/>
                <t t-esc="state.error"/>
            </div>
        </div>
    </t>
</templates>
