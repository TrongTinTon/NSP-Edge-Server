<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nsp_device_type_list" model="ir.ui.view">
        <field name="name">nsp.device.type.list</field>
        <field name="model">nsp.device.type</field>
        <field name="arch" type="xml">
            <list string="Device Types">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_nsp_device_type_form" model="ir.ui.view">
        <field name="name">nsp.device.type.form</field>
        <field name="model">nsp.device.type</field>
        <field name="arch" type="xml">
            <form string="Device Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" string="Technical Code" readonly="1" widget="CopyClipboardChar"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nsp_device_type_search" model="ir.ui.view">
        <field name="name">nsp.device.type.search</field>
        <field name="model">nsp.device.type</field>
        <field name="arch" type="xml">
            <search string="Device Types">
                <field name="name"/>
                <field name="code" string="Technical Code"/>
            </search>
        </field>
    </record>
    <record id="action_nsp_device_type" model="ir.actions.act_window">
        <field name="name">Device Types</field>
        <field name="res_model">nsp.device.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_device_type_search"/>
        <field name="domain">[('code', '!=', 'ANTENNA')]</field>
    </record>
</odoo>
