<?xml version='1.0' encoding='UTF-8'?>
<odoo><record id="view_nsp_measurement_result_form" model="ir.ui.view">
        <field name="name">nsp.measurement.result.form</field>
        <field name="model">nsp.measurement.result</field>
        <field name="arch" type="xml">
            <form string="Result">
                <header>
                    <button name="action_submit_validation" type="object" string="Validate" icon="fa-flask" help="Send this result to Validation." class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_accept" type="object" string="Accept" icon="fa-check" help="Accept this validated result." class="oe_highlight" invisible="state != 'validation' or validation_state != 'passed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validation,accepted,superseded"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="revision" readonly="1"/>
                            <field name="reference_vehicle_id" readonly="1"/>
                            <field name="accepted_pass_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="path_display" readonly="1"/>
                            <field name="total_duration" readonly="1"/>
                            <field name="tolerance_percent"/>
                            <field name="validation_state" widget="badge" readonly="1"/>
                            <field name="validated_run_id" readonly="1"/>
                            <field name="validated_at" readonly="1"/>
                            <field name="accepted_at" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Timeline"/>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence"/>
                            <field name="reader_id"/>
                            <field name="port_no"/>
                            <field name="duration_standard"/>
                            <field name="duration_min" optional="hide"/>
                            <field name="duration_average" optional="hide"/>
                            <field name="duration_p95" optional="hide"/>
                            <field name="duration_max" optional="hide"/>
                            <field name="sample_count"/>
                            <field name="cumulative_time"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nsp_measurement_validation_run_form" model="ir.ui.view">
        <field name="name">nsp.measurement.validation.run.form</field>
        <field name="model">nsp.measurement.validation.run</field>
        <field name="arch" type="xml">
            <form string="Validation">
                <header>
                    <button name="action_load_active_vehicles" type="object" string="Load" help="Load active Vehicles." icon="fa-car" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" icon="fa-play" help="Start Validation." class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_stop_and_analyse" type="object" string="Stop" icon="fa-stop" help="Stop and analyse." class="oe_highlight" invisible="state != 'running'"/>
                    <button name="action_new_run_all" type="object" string="New" icon="fa-plus" help="Create a new run for all Vehicles." invisible="state not in ('passed','failed','completed')"/>
                    <button name="action_retest_failed" type="object" string="Failed" icon="fa-repeat" help="Re-test failed Vehicles." invisible="state not in ('passed','failed','completed')"/>
                    <button name="action_retest_selected" type="object" string="Selected" icon="fa-check-square-o" help="Re-test selected Vehicles." invisible="state not in ('passed','failed','completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,passed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="result_id" domain="[('state','=','validation')]" readonly="state != 'draft'"/>
                            <field name="test_mode"/>
                            <field name="planned_vehicle_count"/>
                            <field name="measurement_revision" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                        </group>
                        <group string="Criteria">
                            <field name="minimum_complete_rate"/>
                            <field name="minimum_port_rate"/>
                            <field name="maximum_wrong_order_rate"/>
                            <field name="complete_rate" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vehicles">
                            <field name="vehicle_line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="1" delete="1" decoration-success="result == 'complete'" decoration-warning="result in ('incomplete','transition_timeout')" decoration-danger="result in ('not_detected','wrong_order')">
                                    <field name="retry_selected" optional="show"/>
                                    <field name="vehicle_id" options="{'no_create': False, 'no_quick_create': False, 'no_create_edit': False}"/>
                                    <field name="tag_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                                    <field name="license_plate" readonly="1"/>
                                    <field name="vehicle_tid" readonly="1"/>
                                    <field name="detected_sequence" readonly="1"/>
                                    <field name="result" widget="badge" readonly="1"/>
                                    <field name="missing_or_error" readonly="1"/>
                                    <field name="total_duration" readonly="1"/>
                                    <field name="detected_at" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reader Ports">
                            <field name="port_stat_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="reader_id"/>
                                    <field name="port_no"/>
                                    <field name="expected_count"/>
                                    <field name="detected_count"/>
                                    <field name="missed_count"/>
                                    <field name="detection_rate"/>
                                </list>
                            </field>
                        </page>
                        <page string="Durations">
                            <field name="transition_stat_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="from_reader_port_id"/>
                                    <field name="to_reader_port_id"/>
                                    <field name="sample_count"/>
                                    <field name="duration_min"/>
                                    <field name="duration_median"/>
                                    <field name="duration_average"/>
                                    <field name="duration_p95"/>
                                    <field name="duration_max"/>
                                    <field name="timeout_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Advice">
                            <field name="recommendation" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_measurement_result" model="ir.actions.act_window">
        <field name="name">Results</field>
        <field name="res_model">nsp.measurement.result</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_nsp_measurement_validation_run" model="ir.actions.act_window">
        <field name="name">Validation</field>
        <field name="res_model">nsp.measurement.validation.run</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
