<?xml version='1.0' encoding='UTF-8'?>
<odoo><record id="view_nsp_measurement_apply_lane_wizard_form" model="ir.ui.view">
        <field name="name">nsp.measurement.apply.lane.wizard.form</field>
        <field name="model">nsp.measurement.apply.lane.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Lane Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>Apply Lane Configuration</h1>
                        <p class="text-muted">
                            Check-in follows the selected row order. Check-out is generated in reverse order.
                        </p>
                    </div>
                    <field name="session_id" invisible="1"/>
                    <group>
                        <group string="Destination">
                            <field name="parking_area_id" string="Parking Layout" required="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': False}"/>
                            <field name="edge_server_id" string="Server" readonly="1"/>
                            <field name="controller_id" string="Controller" readonly="1"/>
                            <field name="lane_id" string="Lane" required="1" readonly="not parking_area_id" domain="[('parking_area_id', '=', parking_area_id), ('edge_server_id', '=', edge_server_id), ('controller_id', '=', controller_id)]" context="{'default_parking_area_id': parking_area_id, 'default_edge_server_id': edge_server_id, 'default_controller_id': controller_id}" options="{'no_create': False, 'no_quick_create': False, 'no_create_edit': False, 'no_open': False}" placeholder="Select or type a new Lane name"/>
                        </group>
                        <group string="Generated Sequences">
                            <field name="selected_count" string="Timeline Points" readonly="1"/>
                            <field name="checkin_overview" string="Check-in" readonly="1"/>
                            <field name="checkout_overview" string="Check-out" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Selected Detection Timeline"/>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="selection_order" string="#"/>
                            <field name="reader_id" string="Reader"/>
                            <field name="serial_number" string="Serial" optional="hide"/>
                            <field name="port_no" string="Port"/>
                            <field name="observed_at" string="Detected"/>
                            <field name="duration_from_previous" string="Duration from Previous (s)"/>
                            <field name="reader_power_dbm" string="Power (dBm)" optional="show"/>
                            <field name="read_interval_ms" string="Read Interval (ms)" optional="show"/>
                            <field name="tid_start_address" string="TID Start" optional="hide"/>
                            <field name="tid_length" string="TID Length" optional="hide"/>
                            <field name="checkin_order" string="Check-in #"/>
                            <field name="checkout_order" string="Check-out #"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_save_configuration" type="object" string="Save" class="btn-primary" icon="fa-save"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    </odoo>
