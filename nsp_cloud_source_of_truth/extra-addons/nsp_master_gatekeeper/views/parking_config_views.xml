<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_nsp_parking_area_search" model="ir.ui.view">
    <field name="name">nsp.parking.operation.search</field>
    <field name="model">nsp.parking.area</field>
    <field name="arch" type="xml">
      <search string="Parking Layout">
        <field name="name"/>
        <field name="branch_id"/>
        <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
        <filter string="Operational" name="operational" domain="[('state','=','operational')]"/>
        <filter string="Maintenance" name="maintenance" domain="[('state','=','maintenance')]"/>
        <filter string="Blocked" name="blocked" domain="[('state','=','blocked')]"/>
        <filter string="Published" name="published" domain="[('published_payload_json','!=',False)]"/>
        <separator/>
        <group>
          <filter string="Branch" name="group_branch" context="{'group_by':'branch_id'}"/>
          <filter string="State" name="group_state" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_nsp_parking_area_list" model="ir.ui.view">
    <field name="name">nsp.parking.operation.list</field>
    <field name="model">nsp.parking.area</field>
    <field name="arch" type="xml">
      <list string="Parking Layout"
            decoration-success="configuration_state == 'ready'"
            decoration-warning="configuration_state == 'incomplete'"
            decoration-muted="configuration_state == 'empty'">
        <field name="state" widget="badge"
               decoration-success="state == 'operational'"
               decoration-warning="state in ('draft','maintenance')"
               decoration-danger="state == 'blocked'"/>
        <field name="name" string="Layout" decoration-bf="1"/>
        <field name="branch_id" string="Branch"/>
        <field name="lane_count" string="Lanes"/>
        <field name="ready_lane_count" string="Ready"/>
        <field name="incomplete_lane_count" string="Attention"/>
        <field name="configuration_state" string="Readiness" widget="badge"
               decoration-success="configuration_state == 'ready'"
               decoration-warning="configuration_state == 'incomplete'"
               decoration-muted="configuration_state == 'empty'"/>
        <field name="published_revision" string="Rev."/>
        <field name="published_at" string="Published" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_nsp_parking_area_form" model="ir.ui.view">
    <field name="name">nsp.parking.operation.form</field>
    <field name="model">nsp.parking.area</field>
    <field name="arch" type="xml">
      <form string="Parking Layout">
        <header>
          <button name="action_set_operational" type="object" string="Publish"
                  icon="fa-cloud-upload" class="oe_highlight"
                  help="Validate and publish this draft revision to Edge."
                  invisible="state != 'draft'"/>
          <button name="action_set_maintenance" type="object" string="Maintenance"
                  icon="fa-wrench" help="Publish Maintenance state."
                  invisible="not is_published or state == 'maintenance' or state == 'draft'"/>
          <button name="action_set_blocked" type="object" string="Block"
                  icon="fa-ban" help="Publish Blocked state."
                  invisible="not is_published or state == 'blocked' or state == 'draft'"/>
          <button name="action_set_operational" type="object" string="Resume"
                  icon="fa-play" class="oe_highlight"
                  help="Return the published runtime snapshot to Operational state."
                  invisible="not is_published or state not in ('maintenance','blocked')"/>
          <button name="action_reset_to_draft" type="object" string="Revise"
                  icon="fa-pencil"
                  help="Open an editable draft while the last published revision remains active on Edge."
                  invisible="state == 'draft'"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,operational,maintenance,blocked"/>
        </header>
        <sheet>
          <field name="is_published" invisible="1"/>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_live_monitor" type="object"
                    class="oe_stat_button" icon="fa-desktop"
                    help="Open the live parking monitor."
                    groups="nsp_core.group_nsp_operator,nsp_core.group_nsp_it_parking,base.group_system">
              <span class="o_stat_text">Live Monitor</span>
            </button>
          </div>

          <div class="oe_title">
            <label for="name" string="Parking Layout"/>
            <h1><field name="name" placeholder="Parking Layout" readonly="state != 'draft'"/></h1>
            <div class="text-muted">
              <field name="code" readonly="1" class="oe_inline"/>
            </div>
          </div>

          <div class="nsp-parking-layout-summary row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-4">
              <div class="nsp-parking-layout-card">
                <div class="nsp-parking-layout-card__label">LANES</div>
                <div class="nsp-parking-layout-card__value"><field name="lane_count" readonly="1" nolabel="1"/></div>
                <div class="nsp-parking-layout-card__meta">
                  <field name="ready_lane_count" readonly="1" nolabel="1"/> ready ·
                  <field name="incomplete_lane_count" readonly="1" nolabel="1"/> attention
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
              <div class="nsp-parking-layout-card">
                <div class="nsp-parking-layout-card__label">INFRASTRUCTURE</div>
                <div class="nsp-parking-layout-card__value"><field name="reader_count" readonly="1" nolabel="1"/> Readers</div>
                <div class="nsp-parking-layout-card__meta">
                  <field name="edge_server_count" readonly="1" nolabel="1"/> Edge ·
                  <field name="controller_count" readonly="1" nolabel="1"/> Controllers
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
              <div class="nsp-parking-layout-card">
                <div class="nsp-parking-layout-card__label">PUBLISHED SNAPSHOT</div>
                <div class="nsp-parking-layout-card__value">Revision <field name="published_revision" readonly="1" nolabel="1"/></div>
                <div class="nsp-parking-layout-card__meta">
                  <field name="published_at" readonly="1" nolabel="1"/>
                </div>
              </div>
            </div>
          </div>

          <group>
            <group string="Layout Identity">
              <field name="branch_id" string="Branch"
                     readonly="state != 'draft'"
                     context="{'form_view_ref': 'nsp_master_gatekeeper.view_nsp_branch_form'}"/>
            </group>
            <group string="Runtime Snapshot">
              <field name="published_edge_server_codes" string="Published Edge Servers" readonly="1"/>
              <field name="configuration_state" string="Configuration" widget="badge" readonly="1"
                     decoration-success="configuration_state == 'ready'"
                     decoration-warning="configuration_state == 'incomplete'"
                     decoration-muted="configuration_state == 'empty'"/>
            </group>
          </group>

          <separator string="Lanes"/>
          <div class="alert alert-secondary" role="alert">
            Publish rule: this Parking Layout must contain at least one Check-in Sequence and one Check-out Sequence. Each Lane may be Check-in only, Check-out only, or bidirectional.
          </div>
          <div class="alert alert-info" role="alert" invisible="state != 'draft' or not is_published">
            You are editing a new draft. The last published revision remains active on Edge until this layout is published again.
          </div>
          <field name="lane_ids" mode="list,form"
                 readonly="state != 'draft'"
                 context="{'default_parking_area_id': id, 'form_view_ref': 'nsp_master_gatekeeper.view_nsp_parking_lane_form'}">
            <list create="1" edit="1" delete="1"
                  decoration-success="configuration_state == 'ready'"
                  decoration-warning="configuration_state == 'incomplete'"
                  decoration-muted="configuration_state == 'disabled'">
              <control><create string="Add Lane"/></control>
              <field name="name" string="Lane" decoration-bf="1"/>
              <field name="available_edge_server_ids" column_invisible="1"/>
              <field name="edge_server_id" string="Server"
                     domain="[('id','in',available_edge_server_ids)]"
                     options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
              <field name="available_controller_ids" column_invisible="1"/>
              <field name="controller_id" string="Controller"
                     domain="[('id','in',available_controller_ids)]"
                     options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
              <field name="timeline_point_count" string="Timeline" readonly="1"/>
              <field name="total_path_duration" string="Duration (s)" readonly="1"/>
              <field name="checkin_point_count" string="Check-in" readonly="1"/>
              <field name="checkout_point_count" string="Check-out" readonly="1"/>
              <field name="configuration_state" column_invisible="1"/>
              <field name="configuration_issue" string="Configuration Check" readonly="1" optional="hide"/>
              <field name="active" widget="boolean_toggle"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_nsp_parking_area" model="ir.actions.act_window">
    <field name="name">Parking Layout</field>
    <field name="res_model">nsp.parking.area</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_nsp_parking_area_search"/>
  </record>

  <record id="view_nsp_parking_lane_list" model="ir.ui.view">
    <field name="name">nsp.parking.lane.list</field>
    <field name="model">nsp.parking.lane</field>
    <field name="arch" type="xml">
      <list string="Lanes"
            decoration-success="configuration_state == 'ready'"
            decoration-warning="configuration_state == 'incomplete'"
            decoration-muted="configuration_state == 'disabled'">
        <field name="parking_area_id" string="Layout"/>
        <field name="name" string="Lane" decoration-bf="1"/>
        <field name="edge_server_id" string="Server"/>
        <field name="controller_id" string="Controller"/>
        <field name="timeline_point_count" string="Timeline" readonly="1"/>
        <field name="total_path_duration" string="Duration (s)" readonly="1"/>
        <field name="checkin_point_count" string="Check-in" readonly="1"/>
        <field name="checkout_point_count" string="Check-out" readonly="1"/>
        <field name="configuration_state" column_invisible="1"/>
        <field name="parking_area_state" column_invisible="1"/>
        <field name="active" widget="boolean_toggle" readonly="parking_area_state != 'draft'"/>
      </list>
    </field>
  </record>

  <record id="view_nsp_parking_lane_form" model="ir.ui.view">
    <field name="name">nsp.parking.lane.form</field>
    <field name="model">nsp.parking.lane</field>
    <field name="arch" type="xml">
      <form string="Lane">
        <sheet>
          <field name="available_controller_ids" invisible="1"/>
          <field name="available_edge_server_ids" invisible="1"/>
          <field name="parking_area_state" invisible="1"/>
          <div class="oe_title">
            <label for="name" string="Lane"/>
            <h1><field name="name" placeholder="Lane" readonly="parking_area_state != 'draft'"/></h1>
            <div class="text-muted"><field name="code" readonly="1" class="oe_inline"/></div>
          </div>

          <div class="nsp-parking-layout-summary row g-3 mb-4">
            <div class="col-12 col-md-4">
              <div class="nsp-parking-layout-card">
                <div class="nsp-parking-layout-card__label">TIMELINE</div>
                <div class="nsp-parking-layout-card__value"><field name="timeline_point_count" readonly="1" nolabel="1"/> points</div>
                <div class="nsp-parking-layout-card__meta"><field name="total_path_duration" readonly="1" nolabel="1"/> seconds total</div>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="nsp-parking-layout-card">
                <div class="nsp-parking-layout-card__label">CHECK-IN</div>
                <div class="nsp-parking-layout-card__value"><field name="checkin_point_count" readonly="1" nolabel="1"/> points</div>
                <div class="nsp-parking-layout-card__meta">Forward direction</div>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="nsp-parking-layout-card">
                <div class="nsp-parking-layout-card__label">CHECK-OUT</div>
                <div class="nsp-parking-layout-card__value"><field name="checkout_point_count" readonly="1" nolabel="1"/> points</div>
                <div class="nsp-parking-layout-card__meta">Reverse direction</div>
              </div>
            </div>
          </div>

          <group>
            <group string="Infrastructure">
              <field name="edge_server_id" string="Server"
                     readonly="parking_area_state != 'draft'"
                     domain="[('id','in',available_edge_server_ids)]"
                     options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
              <field name="controller_id" string="Controller"
                     readonly="parking_area_state != 'draft'"
                     domain="[('id','in',available_controller_ids)]"
                     options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </group>
            <group string="Runtime Settings">
              <field name="tolerance_type" string="Tolerance Unit" readonly="parking_area_state != 'draft'"/>
              <field name="tolerance_value" string="Tolerance" readonly="parking_area_state != 'draft'"/>
              <field name="active" readonly="parking_area_state != 'draft'"/>
            </group>
          </group>

          <notebook>
            <page string="Detection Timeline" name="timeline">
              <div class="alert alert-secondary" role="alert">
                Create the Lane Timeline manually or keep the timeline generated from Lane Calibration. Add Reader Ports in travel order. The first point must use 0 seconds; every following point must have a positive Duration from Previous.
              </div>
              <field name="timeline_line_ids"
                     readonly="parking_area_state != 'draft'"
                     nolabel="1"
                     context="{'default_lane_id': id}">
                <list editable="bottom" create="1" edit="1" delete="1">
                  <control>
                    <create string="Add Timeline Point"/>
                  </control>
                  <field name="sequence" string="Order"/>
                  <field name="available_reader_ids" column_invisible="1"/>
                  <field name="reader_id" string="Reader"
                         domain="[('id','in',available_reader_ids)]"
                         options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                  <field name="port_no" string="Port"/>
                  <field name="duration_from_previous" string="Duration from Previous (s)"/>
                  <field name="cumulative_time" string="Cumulative Time (s)" readonly="1"/>
                </list>
              </field>
            </page>
            <page string="Event Sequences" name="sequences">
              <div class="alert alert-info" role="alert">
                Each Lane must configure Check-in, Check-out, or both. Across the Parking Layout, at least one Check-in and one Check-out Sequence are required before Publish.
              </div>
              <group col="2">
                <group string="Check-in">
                  <field name="checkin_sequence_ids" nolabel="1"
                         readonly="parking_area_state != 'draft'"
                         context="{'default_lane_id': id, 'default_sequence_type': 'check_in'}">
                    <list editable="bottom" create="1" delete="1">
                      <control><create string="Add Check-in Point"/></control>
                      <field name="sequence" string="#"/>
                      <field name="sequence_type" column_invisible="1"/>
                      <field name="available_reader_ids" column_invisible="1"/>
                      <field name="reader_id" string="Reader"
                             domain="[('id','in',available_reader_ids)]"
                             options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                      <field name="port_no" string="Port"/>
                    </list>
                  </field>
                </group>
                <group string="Check-out">
                  <field name="checkout_sequence_ids" nolabel="1"
                         readonly="parking_area_state != 'draft'"
                         context="{'default_lane_id': id, 'default_sequence_type': 'check_out'}">
                    <list editable="bottom" create="1" delete="1">
                      <control><create string="Add Check-out Point"/></control>
                      <field name="sequence" string="#"/>
                      <field name="sequence_type" column_invisible="1"/>
                      <field name="available_reader_ids" column_invisible="1"/>
                      <field name="reader_id" string="Reader"
                             domain="[('id','in',available_reader_ids)]"
                             options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                      <field name="port_no" string="Port"/>
                    </list>
                  </field>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_nsp_parking_lane" model="ir.actions.act_window">
    <field name="name">Lanes</field>
    <field name="res_model">nsp.parking.lane</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
