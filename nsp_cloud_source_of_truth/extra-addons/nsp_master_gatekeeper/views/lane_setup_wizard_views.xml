<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nsp_lane_direction_setup_wizard_form" model="ir.ui.view">
        <field name="name">nsp.lane.setup.wizard.form</field>
        <field name="model">nsp.lane.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Lane Setup" class="o_nsp_lane_setup_form">
                <sheet>
                    <field name="source_scope" invisible="1"/>
                    <field name="session_id" invisible="1"/>
                    <field name="available_reader_ids" invisible="1"/>
                    <field name="active_section" invisible="1"/>
                    <field name="parking_area_branch_id" invisible="1"/>
                    <field name="layout_lane_id" invisible="1"/>
                    <field name="sequence_preview_anchor" invisible="1"/>
                    <field name="edge_server_id" invisible="1"/>
                    <field name="controller_id" invisible="1"/>

                    <!-- Hydrate the transient Reader configuration collection for the
                         reusable Device Tree.  The Tree is the only Device editor. -->
                    <field name="device_line_ids" invisible="1">
                        <list create="1" edit="1" delete="1">
                            <field name="reader_id"/>
                            <field name="reader_name"/>
                            <field name="reader_serial_number"/>
                            <field name="reader_status"/>
                            <field name="port_summary"/>
                            <field name="power_dbm"/>
                            <field name="read_interval_ms"/>
                            <field name="tid_start_address"/>
                            <field name="tid_length"/>
                        </list>
                    </field>

                    <div class="nsp-lane-setup__lane-row">
                        <span class="nsp-lane-setup__lane-label">Parking Layout</span>
                        <div class="nsp-lane-setup__lane-field">
                            <field name="parking_area_id"
                                   nolabel="1"
                                   placeholder="Select a Draft Parking Layout..."
                                   domain="[('state', '=', 'draft')]"
                                   readonly="source_scope == 'parking_layout'"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': False}"/>
                        </div>
                    </div>

                    <div class="nsp-lane-setup__lane-row">
                        <span class="nsp-lane-setup__lane-label">Lane</span>
                        <div class="nsp-lane-setup__lane-field">
                            <field name="lane_id"
                                   nolabel="1"
                                   placeholder="Select or create an independent Lane..."
                                   domain="[('active', '=', True), ('branch_id', '=', parking_area_branch_id)] if parking_area_branch_id else [('active', '=', True)]"
                                   readonly="source_scope == 'parking_layout'"
                                   context="{'default_branch_id': parking_area_branch_id, 'form_view_ref': 'nsp_master_gatekeeper.view_nsp_parking_lane_form'}"
                                   options="{'no_create': False, 'no_quick_create': False, 'no_create_edit': False, 'no_open': False}"/>
                        </div>
                    </div>

                    <div class="nsp-lane-setup__workspace">
                        <aside class="nsp-lane-setup__sidebar">
                            <button name="action_show_device"
                                    type="object"
                                    string="Device"
                                    icon="fa-microchip"
                                    class="btn nsp-lane-setup__nav is-active"
                                    invisible="active_section != 'device'"/>
                            <button name="action_show_device"
                                    type="object"
                                    string="Device"
                                    icon="fa-microchip"
                                    class="btn nsp-lane-setup__nav"
                                    invisible="active_section == 'device'"/>

                            <button name="action_show_sequence"
                                    type="object"
                                    string="Antenna Sequence"
                                    icon="fa-random"
                                    class="btn nsp-lane-setup__nav is-active"
                                    invisible="active_section != 'sequence'"/>
                            <button name="action_show_sequence"
                                    type="object"
                                    string="Antenna Sequence"
                                    icon="fa-random"
                                    class="btn nsp-lane-setup__nav"
                                    invisible="active_section == 'sequence'"/>
                        </aside>

                        <main class="nsp-lane-setup__content">
                            <section class="nsp-lane-setup__content-section"
                                     invisible="active_section != 'device'">
                                <div class="nsp-lane-setup__content-header">
                                    <h3>Device Configuration</h3>
                                    <p>Use the same Server → Controller → Reader configuration structure as Lane Calibration.</p>
                                </div>
                                <field name="device_tree_anchor"
                                       nolabel="1"
                                       class="o_nsp_device_tree_field"
                                       widget="nsp_device_tree_view"/>
                            </section>

                            <section class="nsp-lane-setup__content-section"
                                     invisible="active_section != 'sequence'">
                                <div class="nsp-lane-setup__content-header">
                                    <h3>Antenna Sequence</h3>
                                    <p>Define the physical Reader/Antenna order used to detect a vehicle crossing this Lane.</p>
                                </div>

                                <div class="nsp-lane-setup__sequence-grid">
                                    <div class="nsp-lane-setup__sequence-editor">
                                        <field name="sequence_line_ids" nolabel="1" class="nsp-lane-setup__sequence">
                                            <list editable="bottom" create="1" delete="1">
                                                <field name="sequence" widget="handle" string="#"/>
                                                <field name="reader_id"
                                                       string="Reader"
                                                       domain="[('active', '=', True)] if parent.source_scope == 'parking_layout' else [('id', 'in', parent.available_reader_ids)]"
                                                       options="{'no_create': True, 'no_open': True}"/>
                                                <field name="port_no" string="Antenna"/>
                                                <field name="antenna" column_invisible="1"/>
                                                <field name="reader_identity" column_invisible="1"/>
                                                <field name="is_first_point" column_invisible="1"/>
                                                <field name="duration_ms"
                                                       string="Max Duration from Previous (ms)"
                                                       readonly="is_first_point"/>
                                            </list>
                                        </field>
                                    </div>

                                    <aside class="nsp-lane-setup__preview-panel">
                                        <div class="nsp-lane-setup__preview-header">
                                            <h4>Sequence Preview</h4>
                                            <p>The same sequence identifies the Lane crossing. Vehicle parking state decides Check-in or Check-out.</p>
                                        </div>
                                        <field name="sequence_preview_anchor"
                                               nolabel="1"
                                               widget="nsp_lane_sequence_preview"/>
                                    </aside>
                                </div>
                            </section>
                        </main>
                    </div>
                </sheet>

                <footer>
                    <button name="action_save"
                            type="object"
                            string="Save"
                            icon="fa-save"
                            class="btn btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
