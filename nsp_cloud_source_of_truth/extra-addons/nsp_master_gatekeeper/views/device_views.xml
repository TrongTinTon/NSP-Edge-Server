<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="nsp_device_view_search" model="ir.ui.view">
        <field name="name">nsp.reader.search</field>
        <field name="model">nsp.device</field>
        <field name="arch" type="xml">
            <search string="Readers">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="connection_type"/>
                <filter string="Online" name="online" domain="[('status','=','online')]"/>
                <filter string="Offline" name="offline" domain="[('status','=','offline')]"/>
                <filter string="Degraded" name="degraded" domain="[('status','=','degraded')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="nsp_device_view_list" model="ir.ui.view">
        <field name="name">nsp.reader.list</field>
        <field name="model">nsp.device</field>
        <field name="arch" type="xml">
            <list string="Readers" create="0" edit="1" delete="0">
                <field name="status" widget="badge" decoration-success="status == 'online'" decoration-danger="status == 'offline'" decoration-warning="status == 'degraded'"/>
                <field name="name" string="Reader" decoration-bf="1"/>
                <field name="serial_number" string="Master Serial" readonly="1"/>
                <field name="runtime_detected_serial_number" string="Detected SDK Serial" readonly="1" optional="show"/>
                <field name="connection_type" string="Physical Connection" optional="show"/>
                <field name="last_seen" readonly="1" optional="show"/>
                <field name="firmware_version" readonly="1" optional="hide"/>
                <field name="antennas" string="Antennas" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="nsp_device_view_form" model="ir.ui.view">
        <field name="name">nsp.reader.form</field>
        <field name="model">nsp.device</field>
        <field name="arch" type="xml">
            <form string="Reader" create="0" edit="1" delete="0">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="offline,online,degraded" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reader Name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Device Declaration">
                            <field name="serial_number" string="Master Serial" readonly="1"/>
                            <field name="runtime_detected_serial_number" string="Detected SDK Serial" readonly="1"/>
                            <field name="connection_type" string="Physical Connection" widget="nsp_grouped_connection"/>
                        </group>
                        <group string="Runtime Status">
                            <field name="status" widget="badge" readonly="1" decoration-success="status == 'online'" decoration-danger="status == 'offline'" decoration-warning="status == 'degraded'"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="firmware_version" readonly="1"/>
                            <field name="runtime_power_dbm" string="Reader Power (dBm)" readonly="1"/>
                            <field name="runtime_read_interval_ms" string="Read Interval ms" readonly="1"/>

                        </group>
                    </group>
                    <group string="TID Parameters">
                        <field name="tid_addr" string="TID Start Address (Words)"/>
                        <field name="tid_len" string="TID Length (Words)"/>
                    </group>
                    <notebook>
                        <page name="antennas" string="Antennas">
                            <div class="alert alert-info" role="alert">
                                Antennas are physical ports owned by this Reader. Reader power applies to all ports; movement timing is configured separately in Parking Layout.
                            </div>
                            <div class="text-muted mb-2">
                                Use Add a line to add physical Antennas while creating or editing this Reader.
                            </div>
                            <field name="antennas_ids" context="{'default_device_id': id}">
                                <list string="Antennas" create="0" edit="1" delete="0">
                                    <control>
                                        <create string="Add a line"/>
                                    </control>
                                    <field name="antenna_no" string="Antenna No"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nsp_device_action" model="ir.actions.act_window">
        <field name="name">Readers</field>
        <field name="res_model">nsp.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nsp_device_view_search"/>
        <field name="view_ids" eval="[(5,0,0),             (0,0, {'view_mode': 'list', 'view_id': ref('nsp_device_view_list')}),             (0,0, {'view_mode': 'form', 'view_id': ref('nsp_device_view_form')})]"/>
    </record>

    <record id="nsp_device_heartbeat_view_list" model="ir.ui.view">
        <field name="name">nsp.reader.runtime.list</field>
        <field name="model">nsp.device</field>
        <field name="arch" type="xml">
            <list string="Reader Runtime Status" create="0" edit="1" delete="0">
                <field name="status" widget="badge" decoration-success="status == 'online'" decoration-danger="status == 'offline'" decoration-warning="status == 'degraded'"/>
                <field name="name" string="Reader"/>
                <field name="serial_number" string="Master Serial"/>
                <field name="runtime_detected_serial_number" string="Detected SDK Serial"/>
                <field name="last_seen"/>
                <field name="firmware_version"/>
                <field name="runtime_power_dbm" string="Reader Power (dBm)"/>
                <field name="runtime_read_interval_ms" string="Read Interval ms"/>

            </list>
        </field>
    </record>

    <record id="action_nsp_device_heartbeat" model="ir.actions.act_window">
        <field name="name">Reader Runtime Status</field>
        <field name="res_model">nsp.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nsp_device_view_search"/>
        <field name="view_ids" eval="[(5,0,0),             (0,0, {'view_mode': 'list', 'view_id': ref('nsp_device_heartbeat_view_list')}),             (0,0, {'view_mode': 'form', 'view_id': ref('nsp_device_view_form')})]"/>
    </record>

    <record id="view_nsp_device_antenna_identity_search" model="ir.ui.view">
        <field name="name">nsp.device.antenna.identity.search</field>
        <field name="model">nsp.device.antenna</field>
        <field name="arch" type="xml">
            <search string="Select Antenna">
                <field name="display_name" string="Antenna"/>
                <field name="whitelist_management_code" string="Management Code"/>
                <field name="serial_number" string="Serial Number"/>
            </search>
        </field>
    </record>

    <record id="view_nsp_device_antenna_identity_list" model="ir.ui.view">
        <field name="name">nsp.device.antenna.identity.list</field>
        <field name="model">nsp.device.antenna</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list string="Select Antenna" create="0" edit="0" delete="0">
                <field name="whitelist_photo" string="Photo" widget="image" class="oe_avatar"/>
                <field name="whitelist_management_code" string="Management Code"/>
                <field name="serial_number" string="Serial Number" optional="show"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_device_antenna_search" model="ir.ui.view">
        <field name="name">nsp.reader.antenna.search</field>
        <field name="model">nsp.device.antenna</field>
        <field name="arch" type="xml">
            <search string="Antennas">
                <field name="antenna_no" string="Antenna No"/>
                <field name="device_id" string="Reader" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="device_serial" string="Reader Serial"/>
                <separator/>
                <group>
                    <filter string="Reader" name="group_device" context="{'group_by':'device_id'}"/>
                    </group>
            </search>
        </field>
    </record>

    <record id="view_nsp_device_antenna_list" model="ir.ui.view">
        <field name="name">nsp.reader.antenna.list</field>
        <field name="model">nsp.device.antenna</field>
        <field name="arch" type="xml">
            <list string="Antennas" create="0" edit="1" delete="0">
                <field name="device_id" string="Reader" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                <field name="antenna_no" string="Antenna No"/>
            </list>
        </field>
    </record>

    <record id="view_nsp_device_antenna_form" model="ir.ui.view">
        <field name="name">nsp.reader.antenna.form</field>
        <field name="model">nsp.device.antenna</field>
        <field name="arch" type="xml">
            <form string="Antenna" create="0" edit="1" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Antenna Configuration">
                            <field name="device_id" string="Reader" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" context="{'form_view_ref': 'nsp_master_gatekeeper.nsp_device_view_form'}"/>
                            <field name="antenna_no" string="Antenna No"/>
                        </group>
                        <group string="Reader Reference">
                            <field name="device_serial" string="Reader Serial" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nsp_device_antenna" model="ir.actions.act_window">
        <field name="name">Antennas</field>
        <field name="res_model">nsp.device.antenna</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5,0,0),             (0,0, {'view_mode': 'list', 'view_id': ref('view_nsp_device_antenna_list')}),             (0,0, {'view_mode': 'form', 'view_id': ref('view_nsp_device_antenna_form')})]"/>
        <field name="search_view_id" ref="view_nsp_device_antenna_search"/>
    </record>
</odoo>
