<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_nsp_lane_direction_setup_wizard_form" model="ir.ui.view">
        <field name="name">nsp.lane.direction.setup.wizard.form</field>
        <field name="model">nsp.lane.direction.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Lane Direction Setup">
                <sheet>
                    <div class="oe_title">
                        <h1>Lane Direction Setup</h1>
                        <p class="text-muted">
                            Detection Timeline is observation data only. Select a Lane, then manually configure the observed Reader/Port path as Lane In or Lane Out.
                        </p>
                    </div>
                    <field name="session_id" invisible="1"/>
                    <group>
                        <group string="Lane">
                            <field name="edge_server_id" readonly="1"/>
                            <field name="controller_id" readonly="1"/>
                            <field name="lane_id"
                                   placeholder="Select or type to create a Lane..."
                                   domain="[('edge_server_id', '=', edge_server_id), ('controller_id', '=', controller_id)]"
                                   context="{'default_edge_server_id': edge_server_id, 'default_controller_id': controller_id}"
                                   options="{'no_create': False, 'no_quick_create': False, 'no_create_edit': False, 'no_open': False}"/>
                            <field name="parking_area_id" invisible="1"/>
                        </group>
                        <group string="Reader Direction">
                            <field name="direction" widget="radio"/>
                            <field name="point_count" string="Observed Points" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Observed Detection Timeline"/>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="sequence" string="#"/>
                            <field name="observed_at" string="Timestamp"/>
                            <field name="reader_id" string="Reader"/>
                            <field name="serial_number" string="Serial" optional="hide"/>
                            <field name="port_no" string="Port"/>
                            <field name="duration_from_previous" string="Duration (s)"/>
                            <field name="reader_power_dbm" string="Power (dBm)" optional="show"/>
                            <field name="read_interval_ms" string="Interval (ms)" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_save_direction" type="object" string="Save Lane Direction" class="btn-primary" icon="fa-random" invisible="not lane_id"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
