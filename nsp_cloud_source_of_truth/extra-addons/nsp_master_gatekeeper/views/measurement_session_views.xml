<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_nsp_measurement_session_search" model="ir.ui.view">
        <field name="name">nsp.measurement.session.search</field>
        <field name="model">nsp.measurement.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="measurement_code" string="Calibration Code"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="Released" name="released" domain="[('status','=','ready')]"/>
                <filter string="Running" name="running" domain="[('status','=','running')]"/>
                <filter string="Completed" name="completed" domain="[('status','=','completed')]"/>
                <filter string="Stopped" name="stopped" domain="[('status','in',('failed','cancelled'))]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by':'workflow_status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_nsp_measurement_session_list" model="ir.ui.view">
        <field name="name">nsp.measurement.session.list</field>
        <field name="model">nsp.measurement.session</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <list string="Lane Calibration" decoration-info="workflow_status == 'running'" decoration-success="workflow_status == 'completed'" decoration-danger="workflow_status == 'stopped'">
                <field name="measurement_code" readonly="1"/>
                <field name="revision"/>
                <field name="workflow_status" widget="badge" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="view_nsp_measurement_session_form" model="ir.ui.view">
        <field name="name">nsp.measurement.session.form</field>
        <field name="model">nsp.measurement.session</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <form string="Lane Calibration" js_class="nsp_lane_calibration_form">
                <header>
                    <button name="action_ready" type="object" string="Release" icon="fa-cloud-upload" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_revise" type="object" string="Revise" icon="fa-pencil" class="btn-secondary" invisible="status not in ('ready','completed')"/>
                    <button name="action_complete" type="object" string="Stop" icon="fa-stop" class="btn-secondary" invisible="status != 'running'"/>
                    <button name="action_open_lane_setup" type="object" string="Lane Setup" icon="fa-random" class="btn-secondary" invisible="event_count &lt; 2"/>
                    <button name="action_cancel" type="object" string="Cancel" icon="fa-times" invisible="status not in ('draft','ready')"/>
                    <field name="event_count" invisible="1"/>
                    <field name="workflow_status" widget="statusbar" statusbar_visible="draft,released,running,completed,stopped" readonly="1"/>
                    <field name="status" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="measurement_code" readonly="1" widget="CopyClipboardChar"/>
                        </h1>
                    </div>
                    <separator string="Calibration Tag"/>
                    <group col="1">
                        <field name="calibration_tid" string="Scan Tag" placeholder="Scan raw RFID TID..." readonly="status != 'draft'"/>
                    </group>
                    <!-- Device Tree data is loaded directly by the OWL widget from
                         nsp.measurement.device.node. Do not mirror it as an editable/hidden
                         x2many in the parent form lifecycle. -->
                    <field name="device_configuration_editable" invisible="1"/>
                    <separator string="Device Configuration"/>
                    <field name="device_tree_anchor" nolabel="1" class="o_nsp_device_tree_field" widget="nsp_device_tree_view"/>
                    <separator string="Detection Timeline"/>
                    <field name="event_count" invisible="1"/>
                    <div class="d-flex justify-content-end mb-2">
                        <button name="action_clear_detection_timeline" type="object" string="Clear" icon="fa-trash" class="btn btn-secondary" confirm="Clear all detections in the current Detection Timeline?" invisible="event_count == 0"/>
                    </div>
                    <field name="event_ids" nolabel="1" readonly="1" domain="[('revision', '=', revision)]">
                        <list string="Detection Timeline" create="0" edit="0" delete="0" default_order="read_at asc, read_at_ms asc, id asc">
                            <field name="timeline_timestamp" string="Timestamp"/>
                            <field name="tid" string="Tag" optional="show"/>
                            <field name="rssi_dbm" string="RSSI"/>
                            <field name="timeline_reader" string="Reader"/>
                            <field name="port_no" string="Port"/>
                            <field name="power_dbm" string="Power (dBm)" optional="hide"/>
                            <field name="read_interval_ms" string="Read Interval (ms)" optional="hide"/>
                            <field name="tid_addr" string="TID Start" optional="hide"/>
                            <field name="tid_len" string="TID Length" optional="hide"/>
                            <field name="timeline_duration_ms" string="Duration (ms)"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_nsp_measurement_session" model="ir.actions.act_window">
        <field name="name">Lane Calibration</field>
        <field name="res_model">nsp.measurement.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nsp_measurement_session_search"/>
    </record>
    <record id="action_nsp_measurement_session_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_nsp_measurement_session_list"/>
        <field name="act_window_id" ref="action_nsp_measurement_session"/>
    </record>
    <record id="action_nsp_measurement_session_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_nsp_measurement_session_form"/>
        <field name="act_window_id" ref="action_nsp_measurement_session"/>
    </record>
</odoo>
