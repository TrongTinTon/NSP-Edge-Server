<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Stable Lane master: identity only, independent from Parking Layout. -->
  <record id="view_nsp_parking_lane_list" model="ir.ui.view">
    <field name="name">nsp.parking.lane.list</field>
    <field name="model">nsp.parking.lane</field>
    <field name="arch" type="xml">
      <list string="Lanes" decoration-muted="not active">
        <field name="name" string="Lane" decoration-bf="1"/>
        <field name="code" string="Code"/>
        <field name="branch_id" string="Branch"/>
        <field name="layout_count" string="Parking Layouts" readonly="1"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_nsp_parking_lane_form" model="ir.ui.view">
    <field name="name">nsp.parking.lane.form</field>
    <field name="model">nsp.parking.lane</field>
    <field name="arch" type="xml">
      <form string="Lane">
        <sheet>
          <div class="oe_title">
            <label for="name" string="Lane"/>
            <h1><field name="name" placeholder="Lane name..."/></h1>
            <div class="text-muted"><field name="code" readonly="1" class="oe_inline"/></div>
          </div>
          <group>
            <field name="branch_id" required="1"/>
            <field name="active"/>
            <field name="layout_count" readonly="1"/>
          </group>
          <separator string="Used in Parking Layouts"/>
          <field name="layout_lane_ids" readonly="1">
            <list create="0" edit="0" delete="0">
              <field name="parking_area_id" string="Parking Layout"/>
              <field name="setup_state" widget="badge"/>
              <field name="configuration_state" widget="badge"/>
              <field name="edge_server_id" string="Server"/>
              <field name="controller_id" string="Controller"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Contextual Lane configuration owned by one Parking Layout. -->
  <record id="view_nsp_parking_layout_lane_form" model="ir.ui.view">
    <field name="name">nsp.parking.layout.lane.form</field>
    <field name="model">nsp.parking.layout.lane</field>
    <field name="arch" type="xml">
      <form string="Lane Configuration" class="o_nsp_parking_lane_form">
        <sheet>
          <field name="parking_area_state" invisible="1"/>
          <field name="setup_state" invisible="1"/>
          <field name="branch_id" invisible="1"/>
          <field name="edge_server_id" invisible="1"/>
          <field name="edge_server_name" invisible="1"/>
          <field name="controller_id" invisible="1"/>
          <field name="controller_name" invisible="1"/>
          <field name="edge_server_status" invisible="1"/>
          <field name="controller_status" invisible="1"/>

          <div class="oe_title">
            <label for="lane_id" string="Lane"/>
            <h1>
              <field name="lane_id"
                     placeholder="Select Lane..."
                     domain="[('active', '=', True), ('branch_id', '=', branch_id)]"
                     context="{'default_branch_id': branch_id, 'form_view_ref': 'nsp_master_gatekeeper.view_nsp_parking_lane_form'}"
                     readonly="parking_area_state != 'draft'"/>
            </h1>
          </div>

          <group>
            <field name="parking_area_id"
                   string="Parking Layout"
                   required="1"
                   domain="[('state', '=', 'draft')]"
                   readonly="parking_area_id or parking_area_state != 'draft'"/>
            <field name="active" readonly="parking_area_state != 'draft'"/>
          </group>

          <field name="reader_config_ids" invisible="1">
            <list create="1" edit="1" delete="1">
              <field name="reader_id"/>
              <field name="reader_name"/>
              <field name="reader_serial_number"/>
              <field name="reader_status"/>
              <field name="port_summary"/>
              <field name="power_dbm"/>
              <field name="read_interval_ms"/>
              <field name="tid_start_address"/>
              <field name="tid_length"/>
            </list>
          </field>

          <separator string="Device Configuration"/>
          <field name="device_tree_anchor"
                 nolabel="1"
                 class="o_nsp_device_tree_field"
                 widget="nsp_device_tree_view"/>

          <separator string="Antenna Sequence"/>
          <div class="nsp-parking-sequence-grid">
            <section class="nsp-parking-sequence-grid__editor">
              <field name="antenna_sequence_ids"
                     nolabel="1"
                     readonly="parking_area_state != 'draft'">
                <list editable="bottom" create="1" edit="1" delete="1">
                  <field name="sequence" string="#" widget="handle"/>
                  <field name="reader_id"
                         string="Reader"
                         domain="[('active', '=', True)]"
                         options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>
                  <field name="port_no" string="Antenna"/>
                  <field name="is_first_point" column_invisible="1"/>
                  <field name="duration_from_previous"
                         string="Max Duration from Previous (s)"
                         readonly="is_first_point"/>
                  <field name="cumulative_time" string="Cumulative (s)" readonly="1" optional="hide"/>
                </list>
              </field>
            </section>
            <aside class="nsp-parking-sequence-grid__preview">
              <div class="nsp-parking-sequence-grid__preview-head">
                <h4>Sequence Preview</h4>
                <p>Live preview of the contextual Reader/Antenna order and timing window.</p>
              </div>
              <div class="nsp-parking-sequence-grid__preview-body">
                <div class="nsp-parking-sequence-grid__preview-sequence">
                  <field name="antenna_sequence_preview_anchor"
                         nolabel="1"
                         widget="nsp_lane_sequence_preview"/>
                </div>
                <div class="nsp-parking-sequence-grid__preview-illustration" aria-label="Lane antenna sequence illustration">
                  <img src="/nsp_master_gatekeeper/static/src/img/antenna_sequence_preview_vehicle.svg"
                       alt="Lane antenna sequence illustration"/>
                </div>
              </div>
            </aside>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_nsp_parking_lane" model="ir.actions.act_window">
    <field name="name">Lanes</field>
    <field name="res_model">nsp.parking.lane</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
